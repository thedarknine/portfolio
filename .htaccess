# The project root is the web root on Hostinger: only public/ may ever be served.
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Force HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Let the SSL certificate renewal through
    RewriteRule ^\.well-known/ - [L]

    # 3. Already inside public/: let public/.htaccess handle it
    RewriteRule ^public/ - [L]

    # 4. Everything else goes to public/, nothing outside it is ever served
    #    (var/log, vendor, src, config, composer.json...)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# If mod_rewrite is ever missing, serve nothing rather than the project root
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
