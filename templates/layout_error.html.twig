{#
    Error pages (404, 403, 500) — see docs/style-guide.md § Error pages.
    Each page sets an `error` hash: code, label, title, lead, command, output and retry (500 only).
    Header, mobile menu and footer read the navigation through PageService, which falls back to the default pages
    (App\Service\FallbackNavigation) when the database is down, so this layout renders on a 500 too.
#}
{% set current_page = { slug: 'error', technicalName: 'error' } %}
{% set request_path = app.request.pathInfo %}
<!DOCTYPE html>
<html lang="fr" data-theme="{{ app.request.cookies.get('theme', 'light') }}">
    <head>
        <meta charset="UTF-8">
        <title>Erreur {{ error.code }} — {{ error.label|capitalize }} | {{ owner_name }}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex">

        <link rel="shortcut icon" type="image/x-icon" href="{{ absolute_url(asset('images/global/favicon.ico')) }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ absolute_url(asset('images/global/apple-touch-icon.png')) }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ absolute_url(asset('images/global/favicon-32x32.png')) }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ absolute_url(asset('images/global/favicon-16x16.png')) }}">

        {{ importmap('app', { nonce: csp_nonce('script') }) }}
    </head>
    <body>
        <div class="main flex min-h-screen flex-col" id="error">
            {{ include('components/header.html.twig') }}

            <main class="flex-1 font-sans text-base leading-relaxed text-on-surface">
                <div class="mx-auto max-w-[1240px] px-6 pt-16 pb-20 lg:pt-22 lg:pb-24">

                    <section class="flex flex-wrap items-center gap-x-16 gap-y-14 border-b border-border pb-16" aria-labelledby="error-title">
                        <div class="min-w-0 max-w-[560px] flex-[1_1_440px]">
                            <p class="mb-4 flex flex-wrap items-center gap-2 font-mono text-[13px]">
                                <span class="rounded-md bg-highlight px-2.5 py-0.5 font-medium text-on-highlight">{{ error.code }}</span>
                                <span class="text-accent-text">{{ error.label }}</span>
                            </p>
                            <h1 id="error-title" class="mb-5 text-[clamp(40px,6vw,56px)] leading-[1.04] font-bold tracking-[-1.5px]">{{ error.title }}</h1>
                            <p class="mb-9 text-lg text-on-surface-muted">{{ error.lead }}</p>
                            <div class="flex flex-wrap gap-3">
                                {% if error.retry ?? false %}
                                <a class="btn btn--primary" href="{{ app.request.requestUri }}">
                                    {{ ux_icon('hugeicons:reload', { 'aria-hidden': 'true' }) }}
                                    Réessayer
                                </a>
                                <a class="btn btn--secondary" href="{{ path('app_home') }}">Retour à l’accueil</a>
                                {% else %}
                                <a class="btn btn--primary" href="{{ path('app_home') }}">
                                    {{ ux_icon('hugeicons:home-01', { 'aria-hidden': 'true' }) }}
                                    Retour à l’accueil
                                </a>
                                <a class="btn btn--secondary" href="{{ path('app_contact') }}">Me contacter</a>
                                {% endif %}
                            </div>
                        </div>

                        {# Terminal: same palette as the shell breadcrumb of the page hero, in both themes #}
                        <figure class="m-0 min-w-0 flex-[1_1_460px] overflow-hidden rounded-2xl border border-[#0b1a2c] bg-[#0b1a2c] shadow-[0_24px_48px_-24px_rgb(11_26_44/25%)] dark:border-border dark:bg-[#0b1726] dark:shadow-[0_24px_48px_-24px_rgb(5_12_22/60%)]">
                            <figcaption class="flex items-center justify-between gap-3 border-b border-white/12 px-[18px] py-3 font-mono text-xs text-[#8fa1b9]">
                                <span>nine@carolinenoyer.fr</span>
                                <span aria-hidden="true">{{ error.code }}</span>
                            </figcaption>
                            <div class="px-[22px] pt-6 pb-7 font-mono text-sm leading-[1.9] wrap-anywhere text-[#b9c6d6]">
                                <p><span class="text-[#3fcf8e]" aria-hidden="true">❯ </span><span class="text-white">{{ error.command }} ~{{ request_path }}</span></p>
                                <p class="mb-3.5 text-[#ff8f85]">{{ error.output }}</p>
                                <p><span class="text-[#3fcf8e]" aria-hidden="true">❯ </span><span class="text-white">ls ~</span></p>
                                <nav aria-label="Pages du site">
                                    <ul class="mb-3.5 flex flex-wrap gap-x-5 gap-y-1">
                                        {% for page in page_manager.getPublishedRootPages() %}
                                        {% if page.category.value != 'about' and page.slug != 'contact' %}
                                        <li>
                                            <a class="inline-flex min-h-8 items-center text-[#4cc3e6] underline decoration-[#4cc3e6]/35 underline-offset-4 hover:decoration-[#4cc3e6]" href="/{{ page.slug }}" title="{{ page.title }}">{{ page.slug }}/</a>
                                        </li>
                                        {% endif %}
                                        {% endfor %}
                                    </ul>
                                </nav>
                                <p aria-hidden="true"><span class="text-[#3fcf8e]">❯ </span><span class="inline-block h-[18px] w-[9px] align-[-3px] bg-[#3aa3c8]"></span></p>
                            </div>
                        </figure>
                    </section>

                    <section class="pt-12" aria-labelledby="error-suggestions">
                        <h2 id="error-suggestions" class="mb-6 font-mono text-[13px] [font-weight:400] text-on-surface-muted">Vous cherchiez peut-être</h2>
                        <ul class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
                            {% for card in [
                                { index: '01', title: 'Mon parcours', text: page_manager.getNbYearsExperience() ~ ' ans dans le web, du code au rôle de Product Owner technique.', link: path('app_experience'), cta: 'Voir mes expériences' },
                                { index: '02', title: 'Mes projets', text: 'Ce que j’ai construit, au travail et pour le plaisir.', link: path('app_projects'), cta: 'Voir les projets' },
                                { index: '03', title: 'Me contacter', text: 'Une question, un lien cassé à signaler ? Écrivez-moi.', link: path('app_contact'), cta: 'Écrire un message' },
                            ] %}
                            <li>
                                <a class="flex h-full flex-col gap-1.5 rounded-[14px] border border-border bg-panel p-7 text-on-surface transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="{{ card.link }}">
                                    <span class="font-mono text-[13px] text-on-surface-muted">{{ card.index }}</span>
                                    <span class="text-[22px] leading-[1.3] font-bold">{{ card.title }}</span>
                                    <span class="text-on-surface-muted">{{ card.text }}</span>
                                    <span class="mt-2 inline-flex items-center gap-2 font-medium text-accent-text">
                                        {{ card.cta }} {{ ux_icon('hugeicons:arrow-right-02', { class: 'size-[18px]', 'aria-hidden': 'true' }) }}
                                    </span>
                                </a>
                            </li>
                            {% endfor %}
                        </ul>
                    </section>

                </div>
            </main>

            {# Short footer: the error page only needs the signature, the links and the cookie settings #}
            <footer class="bg-surface-footer font-mono text-[13px] text-on-surface-footer">
                <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-7">
                    <p class="flex flex-wrap items-center gap-x-6 gap-y-2">
                        <span>
                            © Nine · {{ page_manager.getStartCareerYear() }}–{{ 'now'|date('Y') }}
                            <span class="ml-2 rounded-md bg-tag px-2 py-0.5 text-white" title="Version du site">{{ site_version }}</span>
                        </span>
                        <button type="button" class="inline-flex min-h-11 cursor-pointer items-center text-band-accent hover:underline" data-consent-open>Gérer les cookies</button>
                    </p>
                    <ul class="flex flex-wrap gap-2" aria-label="Réseaux et liens">
                        {% for resource in page_manager.getPublishedResourceLinks() %}
                        <li>
                            <a
                                class="inline-flex size-11 items-center justify-center rounded-[10px] border border-band-border text-white transition-colors hover:border-band-accent hover:text-band-accent"
                                href="{{ resource.url }}"
                                target="_blank"
                                rel="noopener"
                                aria-label="{{ resource.title }}">
                                {{ ux_icon(resource.icon, { class: 'size-5', 'aria-hidden': 'true' }) }}
                            </a>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </footer>
        </div>

        {{ include('components/cookie_consent.html.twig') }}
    </body>
</html>
