    <section class="nine-page-hero">
        <div class="container nine-hero-grid">
            <div class="nine-hero-content animate__animated" data-animate="animate__fadeInLeft">
                <span class="nine-section-label">{{ tagline }}</span>
                <h1 class="nine-tagline text-3xl font-bold mb-6">{{ subtitle }}</h1>
            </div>

            <div class="nine-hero-visual min-h-50 overflow-hidden animate__animated" data-animate="animate__fadeInRight">
                <img
                    src="images/{{ slug }}/hero-{{ slug }}.jpg"
                    alt="{{ pagetitle }}"
                    class="w-full object-cover"
                    style="clip-path: ellipse(100% 140% at 100% 50%);"
                />
            </div>
        </div>
    </section>
