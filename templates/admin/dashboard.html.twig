{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}
<div class="container-fluid">
    {# HERO #}
    <div class="card border-0 shadow-sm mb-4 overflow-hidden">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div>
                <div class="text-uppercase small text-muted mb-2">Portfolio Administration</div>
                <h1 class="display-6 fw-bold mb-2">Tableau de bord</h1>
                <p class="text-muted mb-0">Gérez l'ensemble du contenu de votre portfolio depuis une interface centralisée.</p>
            </div>
            <div class="text-end">
                <div class="fw-semibold">{{ app.user.email }}</div>
                <div class="text-muted small">{{ 'now'|date('d/m/Y • H:i') }}</div>
                <a href="{{ path('app_index') }}" target="_blank" class="btn btn-dark btn-sm mt-3">
                    <i class="fa fa-globe me-2"></i>Voir le site
                </a>
            </div>
        </div>
    </div>

    {# MAIN STATS #}
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-muted small mb-2">Projets</div>
                            <div class="display-6 fw-bold">{{ stats.projects }}</div>
                            <div class="mt-2 text-muted xsmall">
                                <span class="text-success"><i class="fa fa-check-circle"></i> {{ stats.publishedProjects }}</span> •
                                <span class="text-warning"><i class="fa fa-pen-to-square"></i> {{ stats.draftProjects }}</span>
                            </div>
                        </div>
                        <div class="stat-icon bg-warning-subtle text-warning">
                            <i class="fa fa-diagram-project"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-muted small mb-2">Expérience</div>
                            <div class="display-6 fw-bold">{{ stats.yearsExperience }} <span class="fs-5">ans</span></div>
                            <div class="mt-2 text-muted xsmall">Depuis oct. 2006</div>
                        </div>
                        <div class="stat-icon bg-success-subtle text-success">
                            <i class="fa fa-briefcase"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-muted small mb-2">Ratio Projets/Exp</div>
                            <div class="display-6 fw-bold">{{ stats.projectsExperienceRatio }}</div>
                            <div class="mt-2 text-muted xsmall">Projets par expérience</div>
                        </div>
                        <div class="stat-icon bg-info-subtle text-info">
                            <i class="fa fa-chart-line"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <div class="text-muted small mb-2">Images & Médias</div>
                            <div class="display-6 fw-bold">{{ stats.totalImages }}</div>
                            <div class="mt-2 text-muted xsmall">
                                <i class="fa fa-hdd"></i> Poids : {{ stats.portfolioDiskUsage }}
                            </div>
                        </div>
                        <div class="stat-icon bg-danger-subtle text-danger">
                            <i class="fa fa-images"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# LAST ADDED CONTENT #}
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h3 class="h6 text-muted text-uppercase fw-bold mb-3">
                        <i class="fa fa-clock text-primary me-2"></i>Dernier Projet Ajouté
                    </h3>
                    {% if stats.latestProject %}
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="h5 fw-bold mb-1">{{ stats.latestProject.name }}</h4>
                                <span class="badge {{ stats.latestProject.published ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' }}">
                                    {{ stats.latestProject.published ? 'Publié' : 'Brouillon' }}
                                </span>
                            </div>
                            <div class="text-muted small text-end">
                                Modifié le<br><strong>{{ stats.latestProject.updatedAt|date('d/m/Y') }}</strong>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted small mb-0">Aucun projet enregistré.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h3 class="h6 text-muted text-uppercase fw-bold mb-3">
                        <i class="fa fa-camera text-info me-2"></i>Dernière Photo (Assets)
                    </h3>
                    {% if stats.latestPhoto %}
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="text-truncate me-2">
                                <div class="fw-bold text-truncate" title="{{ stats.latestPhoto.filename }}">
                                    {{ stats.latestPhoto.filename }}
                                </div>
                                <span class="text-muted small">Dossier: /photos</span>
                            </div>
                            <div class="text-muted small text-end text-nowrap">
                                Synchro le<br><strong>{{ stats.latestPhoto.updatedAt }}</strong>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted small mb-0">Aucune photo trouvée dans le dossier.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# ACTIONS & ENVIRONMENT #}
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="mb-4">
                        <h2 class="h4 fw-bold mb-1">Gestion du contenu</h2>
                        <p class="text-muted small mb-0">Accès rapide aux sections principales de votre portfolio</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController') }}" class="dashboard-link">
                                <i class="fa fa-diagram-project"></i>
                                <div class="d-flex flex-column">
                                    <span>Projets</span>
                                    <small class="text-muted xsmall">{{ stats.projects }} éléments</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\ExperienceCrudController') }}" class="dashboard-link">
                                <i class="fa fa-briefcase"></i>
                                <div class="d-flex flex-column">
                                    <span>Expériences</span>
                                    <small class="text-muted xsmall">Parcours pro</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\SkillCrudController') }}" class="dashboard-link">
                                <i class="fa fa-code"></i>
                                <div class="d-flex flex-column">
                                    <span>Compétences</span>
                                    <small class="text-muted xsmall">{{ stats.technologiesCount }} technos</small>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a href="{{ ea_url().setController('App\\Controller\\Admin\\PageCrudController') }}" class="dashboard-link">
                                <i class="fa fa-file-lines"></i>
                                <div class="d-flex flex-column">
                                    <span>Pages</span>
                                    <small class="text-muted xsmall">{{ stats.publicPages }} actives</small>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 fw-bold mb-4">Système & Serveur</h2>

                    <div class="env-item">
                        <span>Framework</span>
                        <strong>Symfony {{ stats.symfonyVersion }}</strong>
                    </div>
                    <div class="env-item">
                        <span>Moteur d'admin</span>
                        <strong>EasyAdmin {{ stats.easyAdminVersion }}</strong>
                    </div>
                    <div class="env-item">
                        <span>PHP version</span>
                        <span class="badge bg-dark">{{ stats.phpVersion }}</span>
                    </div>
                    <div class="env-item">
                        <span>Mode d'exécution</span>
                        <span class="badge bg-danger-subtle text-danger text-uppercase">{{ app.environment }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.stat-card {
    transition: all .15s ease;
}
.stat-card:hover {
    transform: translateY(-4px);
}
.stat-icon {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
}
.dashboard-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px;
    border-radius: 14px;
    background: #f8fafc;
    text-decoration: none;
    color: #0f172a;
    transition: all .15s ease;
    font-weight: 500;
}
.dashboard-link:hover {
    background: #eef2ff;
    transform: translateX(4px);
    color: #4338ca;
}
.env-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid #e5e7eb;
}
.env-item:last-child {
    border-bottom: none;
}
.xsmall {
    font-size: 0.75rem;
}
</style>
{% endblock %}
