{% extends 'layout.html.twig' %}

{# Contact — see docs/style-guide.md § Contact and § Forms #}

{% block meta_description %}
Vous souhaitez échanger sur un projet ou une collaboration ? Contactez Caroline Noyer, Technical Product Owner.
{% endblock %}

{% form_theme form _self %}
{% block form_errors %}
{% if errors|length > 0 %}
<ul class="flex flex-col gap-1">
    {% for error in errors %}
    <li class="field__error">
        {{ ux_icon('hugeicons:alert-circle', { 'aria-hidden': 'true' }) }}
        <span>{{ error.message }}</span>
    </li>
    {% endfor %}
</ul>
{% endif %}
{% endblock %}

{% macro field(child, label) %}
{% set error_id = child.vars.id ~ '_error' %}
<div class="field">
    <label for="{{ child.vars.id }}" class="field__label">
        {{ label }}<span class="field__required" aria-hidden="true">*</span>
    </label>
    {% set widget_attr = child.vars.attr|merge({ class: 'field__input' }) %}
    {% if not child.vars.valid %}
    {% set widget_attr = widget_attr|merge({ 'aria-invalid': 'true', 'aria-describedby': error_id }) %}
    {% endif %}
    {{ form_widget(child, { attr: widget_attr }) }}
    <div id="{{ error_id }}">
        {{ form_errors(child) }}
    </div>
</div>
{% endmacro %}

{% block body %}
<div class="font-sans text-base leading-relaxed text-on-surface">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-12 px-6 py-18 lg:flex-row lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:w-[380px] lg:shrink-0 lg:self-start">
            <p class="mb-2 font-mono text-[13px] text-accent-text">contact</p>
            <h2 class="mb-6 text-[clamp(26px,3vw,32px)] leading-[1.15] font-bold tracking-[-0.5px]">Écrivez-moi</h2>
            <div class="flex flex-col gap-4 text-on-surface-muted">
                <p>Merci de votre visite sur mon portfolio.</p>
                <p>
                    Cette page est à votre disposition si vous souhaitez me contacter à propos de mon parcours,
                    d'un projet présenté sur le site ou d'une opportunité professionnelle. J'apprécie également
                    les échanges entre développeurs et les retours sur les réalisations que je partage.
                </p>
                <p>Je m'efforce de répondre à chaque demande dans les meilleurs délais.</p>
            </div>

            {% set resources = page_manager.getPublishedResourceLinks() %}
            {% if resources is not empty %}
            <p class="mt-10 mb-3 font-mono text-[13px] text-on-surface-muted">Ailleurs</p>
            <ul class="flex flex-wrap gap-2" aria-label="Réseaux et liens">
                {% for resource in resources %}
                <li>
                    <a
                        class="inline-flex size-11 items-center justify-center rounded-[10px] border border-border bg-panel text-on-surface transition-colors hover:border-accent-text hover:text-accent-text"
                        href="{{ resource.url }}"
                        target="_blank"
                        rel="noopener"
                        aria-label="{{ resource.title }}"
                        title="{{ resource.title }}">
                        {{ ux_icon(resource.icon, { class: 'size-5', 'aria-hidden': 'true' }) }}
                    </a>
                </li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>

        <div class="min-w-0 max-w-[720px] flex-1">
            <div class="rounded-[18px] border border-border bg-panel p-6 sm:p-10">
                {% for msg in app.flashes('success') %}
                <div class="alert alert--success mb-8" role="status" data-flash="success">
                    {{ ux_icon('hugeicons:checkmark-circle-02', { 'aria-hidden': 'true' }) }}
                    <p>{{ msg }}</p>
                </div>
                {% endfor %}
                {% for msg in app.flashes('error') %}
                <div class="alert alert--error mb-8" role="alert">
                    {{ ux_icon('hugeicons:alert-circle', { 'aria-hidden': 'true' }) }}
                    <p>{{ msg }}</p>
                </div>
                {% endfor %}

                {{ form_start(form, { attr: { class: 'flex flex-col gap-6', novalidate: 'novalidate' } }) }}
                <div class="grid gap-6 sm:grid-cols-2">
                    {{ _self.field(form.name, 'Nom') }}
                    {{ _self.field(form.email, 'Email') }}
                </div>
                {{ _self.field(form.subject, 'Sujet') }}
                {{ _self.field(form.message, 'Message') }}

                {# Altcha widget #}
                {{ form_row(form.security) }}

                <div class="flex flex-wrap items-center justify-between gap-4 border-t border-border pt-6">
                    <p class="font-mono text-[13px] text-on-surface-muted"><span class="text-accent-text" aria-hidden="true">*</span> Tous les champs sont obligatoires</p>
                    <button type="submit" class="btn btn--primary group">
                        Envoyer
                        {{ ux_icon('hugeicons:sent', { class: 'motion-safe:transition-transform motion-safe:group-hover:translate-x-1', 'aria-hidden': 'true' }) }}
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
