{% extends 'layout_case_study.html.twig' %}

{% block case_study %}
{% set check = 'hugeicons:checkmark-circle-02' %}
{% set h2 = 'mb-4 text-[clamp(24px,2.6vw,28px)] leading-[1.2] font-bold tracking-[-0.4px] text-title' %}
{% set strong = 'text-title font-bold' %}
<section>
    <div class="case-callout mb-6">
        {{ ux_icon('hugeicons:target-02', { class: 'text-accent-text text-xl shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
        <p class="text-on-surface-muted">
            <strong class="{{ strong }}">Le défi</strong> : donner un cadre à un pôle produit tout juste créé.
        </p>
    </div>

    <h2 class="{{ h2 }}">Un pôle produit sans repères communs</h2>
    <p class="text-on-surface-muted mb-3 leading-relaxed">
        Quand j’ai rejoint <strong class="{{ strong }}">Perfect Memory</strong>, le pôle produit venait d’être créé.
        Les équipes travaillaient en silos, les fonctionnalités étaient documentées de façon dispersée,
        et personne n’avait de vue d’ensemble sur ce qui existait ou était en cours de développement.
    </p>
    <p class="text-on-surface-muted leading-relaxed">
        Conséquences : des <strong class="{{ strong }}">développements en double</strong>, des malentendus entre équipes,
        et du temps perdu par les squads pour trouver la bonne information.
    </p>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:user-circle', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Mon rôle : structurer le pôle produit
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        Mon objectif : donner aux squads un <strong class="{{ strong }}">découpage clair</strong>
        et <strong class="{{ strong }}">centraliser l’information</strong>, pour que chacun sache quoi faire et où trouver ce dont il a besoin.
    </p>

    <div class="space-y-6">
        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:book-open-01', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 1 : Créer un référentiel de fonctionnalités
            </h3>
            <p class="text-on-surface-muted mb-3 leading-relaxed">
                J’ai cartographié toutes les fonctionnalités existantes dans un espace partagé.
            </p>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Une structure commune</strong> : chaque fonctionnalité est décrite avec ses spécifications, son statut et ses dépendances.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Un point d’entrée unique</strong> pour toutes les équipes.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:bulb', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 2 : Outiller la discovery
            </h3>
            <p class="text-on-surface-muted mb-3 leading-relaxed">
                J’ai déployé <strong class="{{ strong }}">Jira Product Discovery</strong> pour collecter et prioriser les idées des clients, des prospects et des équipes internes :
            </p>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Centralisation</strong> : toutes les idées au même endroit.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Scoring</strong> : chaque idée est évaluée selon son impact, sa faisabilité et son alignement avec les objectifs produit.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Roadmap partagée</strong> : les idées priorisées alimentent une feuille de route visible par tous.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Suivi des livraisons</strong> : chaque évolution livrée est documentée et son impact suivi.</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="mt-8">
        <p class="mb-3 flex items-center gap-2 font-mono text-[13px] text-on-surface-muted">
            {{ ux_icon('hugeicons:toolbox', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Outils utilisés
        </p>
        <div class="case-tools">
            <span title="Jira">{{ ux_icon('logos:jira', { class: 'w-6 h-6' }) }}</span>
            <span title="Confluence">{{ ux_icon('logos:confluence', { class: 'w-6 h-6' }) }}</span>
            <span title="Jira Product Discovery">{{ ux_icon('logos:atlassian', { class: 'w-6 h-6' }) }}</span>
        </div>
    </div>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:rocket-01', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Le résultat : un pôle produit aligné
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        En quelques mois, le pôle produit disposait d’un cadre commun et d’un flux d’idées alimenté par toute l’entreprise.
    </p>

    <div class="case-card">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:chart-increase', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Résultats
        </h3>
        <ul class="space-y-2">
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Plus de 300 idées collectées</strong> auprès des clients, des prospects et des équipes internes.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Plus de 100 idées mises en production en 8 mois</strong>, après priorisation.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Moins de doublons</strong> : les équipes vérifient dans le référentiel avant de développer.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Du temps gagné</strong> : les squads trouvent l’information sans avoir à la chercher auprès de chacun.</span>
            </li>
        </ul>
    </div>
</section>
{% endblock %}
