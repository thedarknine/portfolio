{% extends 'layout_case_study.html.twig' %}

{% block case_study %}
{% set check = 'hugeicons:checkmark-circle-02' %}
{% set check_class = 'text-accent-text text-base shrink-0 mt-0.5' %}
{% set h2 = 'mb-4 text-[clamp(24px,2.6vw,28px)] leading-[1.2] font-bold tracking-[-0.4px] text-title' %}
{% set h3 = 'text-lg font-semibold text-accent-text mb-2 flex items-center gap-2' %}
{% set strong = 'text-title font-bold' %}
<section>
    <div class="case-callout mb-6">
        {{ ux_icon('hugeicons:target-02', { class: 'text-accent-text text-xl shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
        <p class="text-on-surface-muted">
            <strong class="{{ strong }}">Le défi</strong> : digitaliser le relevé d’heures des intérimaires, pour accélérer la facturation et la paie.
        </p>
    </div>

    <h2 class="{{ h2 }}">Des relevés d’heures encore sur papier</h2>
    <p class="text-on-surface-muted mb-3 leading-relaxed">
        Chez <strong class="{{ strong }}">Coffreo</strong>, spécialiste de la dématérialisation RH pour l’intérim,
        le relevé d’heures des intérimaires se faisait encore souvent <strong class="{{ strong }}">sur papier</strong>,
        ou avec des outils hétérogènes et peu fiables.
    </p>
    <p class="text-on-surface-muted mb-1 leading-relaxed">
        <strong class="{{ strong }}">Conséquences</strong> :
    </p>
    <ul class="space-y-2">
        <li class="flex items-start gap-2 text-on-surface-muted">
            {{ ux_icon('hugeicons:cancel-square', { class: 'text-danger text-lg shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
            <span><strong class="{{ strong }}">Du temps perdu</strong> : les agences relançaient leurs clients pour obtenir les heures non saisies.</span>
        </li>
        <li class="flex items-start gap-2 text-on-surface-muted">
            {{ ux_icon('hugeicons:cancel-square', { class: 'text-danger text-lg shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
            <span><strong class="{{ strong }}">Des retards de facturation et de paie</strong>, avec un effet direct sur la trésorerie des agences.</span>
        </li>
        <li class="flex items-start gap-2 text-on-surface-muted">
            {{ ux_icon('hugeicons:cancel-square', { class: 'text-danger text-lg shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
            <span><strong class="{{ strong }}">Des erreurs</strong> : un processus manuel, source de ressaisies et de tensions.</span>
        </li>
    </ul>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:user-circle', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Mon rôle : Squad Leader de Timesheet
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        J’ai porté la conception et le lancement de <strong class="{{ strong }}">Timesheet</strong>, de l’analyse technique au déploiement,
        avec une équipe de <strong class="{{ strong }}">4 développeurs</strong> et en lien avec les équipes métier.
        Un double défi : s’intégrer dans une infrastructure existante et répondre aux besoins concrets des agences.
    </p>

    <div class="space-y-6">
        <div class="case-step">
            <h3 class="{{ h3 }}">
                {{ ux_icon('hugeicons:search-01', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 1 : Analyse et architecture
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Comprendre les contraintes</strong> : infrastructure existante, besoins métier, obligations légales.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Choisir une architecture</strong> capable de suivre 600 agences et des milliers d’utilisateurs.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Définir les API</strong> et le format JSON des échanges.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="{{ h3 }}">
                {{ ux_icon('hugeicons:puzzle', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 2 : Intégration dans l’écosystème Coffreo
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Modélisation des données</strong> : heures, utilisateurs, missions.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Liens avec les autres modules</strong>, comme la gestion des contrats et la paie.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Sécurité et RGPD</strong> : protection des données personnelles.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="{{ h3 }}">
                {{ ux_icon('hugeicons:laptop-programming', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 3 : Développement et suivi
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Suivi quotidien</strong> : stand-ups et revues de code.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Planification des versions</strong> et des mises en production, en Scrum.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Coordination avec le Delivery et le Support</strong> pour préparer la mise en service.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="{{ h3 }}">
                {{ ux_icon('hugeicons:user-group', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 4 : Phase pilote et onboarding
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Phase pilote avec 4 clients</strong> pour affiner l’outil avant le lancement.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Accompagnement des utilisateurs</strong> : ateliers et documentation.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Onboarding progressif</strong> dans l’application, avec Userpilot.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="{{ h3 }}">
                {{ ux_icon('hugeicons:wrench-01', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 5 : Maintenance et évolutions
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Suivi des logs</strong> et correction des bugs.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Documentation</strong> tenue à jour pour les équipes et les clients.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">API publique sécurisée</strong> pour connecter Timesheet aux SI des clients.</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="mt-8">
        <p class="mb-3 flex items-center gap-2 font-mono text-[13px] text-on-surface-muted">
            {{ ux_icon('hugeicons:toolbox', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Outils utilisés
        </p>
        <div class="case-tools">
            <span title="Symfony">{{ ux_icon('logos:symfony', { class: 'w-6 h-6' }) }}</span>
            <span title="MySQL">{{ ux_icon('logos:mysql', { class: 'w-6 h-6' }) }}</span>
            <span title="API">{{ ux_icon('gcp:api', { class: 'w-6 h-6' }) }}</span>
            <span title="Jira">{{ ux_icon('logos:jira', { class: 'w-6 h-6' }) }}</span>
            <span title="GitLab">{{ ux_icon('logos:gitlab-icon', { class: 'w-6 h-6' }) }}</span>
            <span title="PhpStorm">{{ ux_icon('logos:phpstorm', { class: 'w-6 h-6' }) }}</span>
            <span title="Grafana">{{ ux_icon('logos:grafana', { class: 'w-6 h-6' }) }}</span>
        </div>
    </div>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:rocket-01', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Le résultat : 600 agences d’intérim équipées
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        Après la phase pilote, Timesheet a été lancé auprès des clients de Coffreo.
    </p>

    <div class="case-card mb-8">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:chart-increase', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Résultats
        </h3>
        <ul class="space-y-2">
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">4 clients pilotes</strong> pour affiner l’outil.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">20 clients dès la V1</strong>, soit 600 agences d’intérim.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Moins de relances</strong> pour les heures non saisies.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Une facturation et une paie plus rapides</strong>, grâce à des heures disponibles plus tôt.</span>
            </li>
        </ul>
    </div>

    <div class="case-card mb-8">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:teaching', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Ce que j’en retiens
        </h3>
        <ul class="space-y-2">
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon('hugeicons:bulb', { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">La phase pilote</strong> : affiner le produit avec de vrais utilisateurs avant le lancement.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon('hugeicons:bulb', { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">La collaboration métier et tech</strong> : travailler avec les équipes terrain dès le départ.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon('hugeicons:bulb', { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">L’onboarding</strong> : Userpilot a facilité la prise en main par les agences.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon('hugeicons:bulb', { class: check_class, 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">La maintenance au quotidien</strong> : suivre les logs pour corriger vite.</span>
            </li>
        </ul>
    </div>

    <div class="story-visual">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:image-03', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }} En images : l’interface Timesheet
        </h3>
        <div class="visual-grid">
            <div class="visual-item">
                <img
                    src="/images/experience/timesheet-dashboard.webp"
                    alt="Capture d'écran du tableau de bord Timesheet"
                    loading="lazy"
                    width="800"
                    height="450"
                    class="mx-auto">
                <p class="case-caption"><strong>Tableau de bord</strong> : les heures saisies et les missions en un coup d’œil.</p>
            </div>
            <div class="visual-item">
                <img
                    src="/images/experience/timesheet-saisie.webp"
                    alt="Capture d'écran de la saisie d'un relevé d'heures"
                    loading="lazy"
                    width="800"
                    class="mx-auto">
                <p class="case-caption"><strong>Saisie des heures</strong> : un formulaire qui couvre les éléments utiles à la paie.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
