{% extends 'layout_case_study.html.twig' %}

{% block meta_description %}
Étude de cas Perfect Memory : concevoir Exposé, une brique B2B2C pour permettre aux clients de vendre leurs médias peu valorisés.
{% endblock %}

{% block case_study %}
{% set check = 'hugeicons:checkmark-circle-02' %}
{% set h2 = 'mb-4 text-[clamp(24px,2.6vw,28px)] leading-[1.2] font-bold tracking-[-0.4px] text-title' %}
{% set strong = 'text-title font-bold' %}
<section>
    <div class="case-callout mb-6">
        {{ ux_icon('hugeicons:target-02', { class: 'text-accent-text text-xl shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
        <p class="text-on-surface-muted">
            <strong class="{{ strong }}">Le défi</strong> : permettre aux clients de Perfect Memory de vendre des médias peu valorisés.
        </p>
    </div>

    <h2 class="{{ h2 }}">Des médias peu valorisés</h2>
    <p class="text-on-surface-muted mb-3 leading-relaxed">
        Chez <strong class="{{ strong }}">Perfect Memory</strong>, spécialiste de l’<strong class="{{ strong }}">IA sémantique</strong>,
        les clients stockaient de nombreux actifs numériques (vidéos, images, documents) dans leur plateforme de gestion d’actifs,
        le <strong class="{{ strong }}">Cognitive Assets Management (CAM)</strong>.
    </p>
    <p class="text-on-surface-muted mb-3 leading-relaxed">
        Ces actifs étaient <strong class="{{ strong }}">peu monétisés</strong> : les clients manquaient d’outils pour les valoriser,
        et Perfect Memory n’avait pas encore de solution dédiée.
    </p>
    <p class="text-on-surface-muted leading-relaxed">
        <strong class="{{ strong }}">L’enjeu</strong> : permettre aux clients de vendre leurs médias,
        en s’appuyant au maximum sur les composants existants du CAM.
    </p>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:user-circle', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Mon rôle : Product Owner sur le MVP d’Exposé™
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        Exposé™ est un <strong class="{{ strong }}">portail de vente d’actifs numériques</strong>, conçu comme une nouvelle brique de la plateforme.
        J’ai participé à son lancement en tant que Product Owner : je recueillais les besoins,
        je rédigeais les <strong class="{{ strong }}">user stories</strong> et je suivais la réalisation jusqu’à la livraison.
    </p>

    <div class="space-y-6">
        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:search-01', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 1 : Recueillir les besoins
            </h3>
            <p class="text-on-surface-muted leading-relaxed">
                J’ai recueilli les besoins exprimés par les clients, avec les <strong class="{{ strong }}">équipes commerciales</strong>
                et le pôle <strong class="{{ strong }}">Professional Service</strong>, pour en tirer des cas d’usage concrets.
            </p>
        </div>

        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:note-edit', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 2 : Rédiger les user stories
            </h3>
            <p class="text-on-surface-muted mb-3 leading-relaxed">
                J’ai rédigé les user stories des fonctionnalités clés du MVP :
            </p>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Portail de vente</strong> : exposer et vendre les actifs numériques.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Réutilisation</strong> : s’appuyer sur le CAM existant plutôt que tout redévelopper.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:agreement-01', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 3 : Suivre la réalisation
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Synchronisation</strong> régulière entre le Professional Service et la R&amp;D, pour aligner les besoins métier et les contraintes techniques.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Ajustement des fonctionnalités</strong> à partir des retours du client pilote.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Recette et tests de non-régression</strong> avant chaque livraison.</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="mt-8">
        <p class="mb-3 flex items-center gap-2 font-mono text-[13px] text-on-surface-muted">
            {{ ux_icon('hugeicons:toolbox', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Outils utilisés
        </p>
        <div class="case-tools">
            <span title="Jira">{{ ux_icon('logos:jira', { class: 'w-6 h-6' }) }}</span>
            <span title="Figma">{{ ux_icon('logos:figma', { class: 'w-6 h-6' }) }}</span>
            <span title="Confluence">{{ ux_icon('logos:confluence', { class: 'w-6 h-6' }) }}</span>
        </div>
    </div>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:rocket-01', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Le résultat : un MVP en production
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        Le MVP d’Exposé™ a été mis en production chez un premier client grand compte,
        <strong class="{{ strong }}">un grand groupe audiovisuel français</strong>.
    </p>

    <div class="case-card mb-8">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:chart-increase', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Résultats
        </h3>
        <ul class="space-y-2">
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Un client grand compte équipé</strong> : il peut vendre ses médias de façon autonome.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Une brique réutilisant l’existant</strong> : Exposé™ s’appuie sur les composants du CAM, ce qui a limité les développements.</span>
            </li>
        </ul>
    </div>

    <div class="story-visual">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:image-03', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }} En images : le portail Exposé™
        </h3>
        <div class="visual-grid">
            <div class="visual-item">
                <img
                    src="/images/experience/expose-portail.webp"
                    alt="Capture d'écran du portail Exposé™"
                    loading="lazy"
                    width="800"
                    height="450"
                    class="mx-auto">
                <p class="case-caption"><strong>Portail de vente</strong> : exposer et vendre les actifs numériques.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
