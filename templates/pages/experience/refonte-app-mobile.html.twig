{% extends 'layout_case_study.html.twig' %}

{% block meta_description %}
Étude de cas Coffreo : refondre l’application mobile des intérimaires, lente et mal notée, pour redonner envie de l’utiliser.
{% endblock %}

{% block case_study %}
{% set check = 'hugeicons:checkmark-circle-02' %}
{% set h2 = 'mb-4 text-[clamp(24px,2.6vw,28px)] leading-[1.2] font-bold tracking-[-0.4px] text-title' %}
{% set strong = 'text-title font-bold' %}
<section>
    <div class="case-callout mb-6">
        {{ ux_icon('hugeicons:target-02', { class: 'text-accent-text text-xl shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
        <p class="text-on-surface-muted">
            <strong class="{{ strong }}">Le défi</strong> : redonner envie d’utiliser une application mobile vieillissante.
        </p>
    </div>

    <h2 class="{{ h2 }}">Une app mobile délaissée par ses utilisateurs</h2>
    <p class="text-on-surface-muted mb-3 leading-relaxed">
        Chez <strong class="{{ strong }}">Coffreo</strong>, l’application mobile destinée aux salariés intérimaires reposait sur des
        <strong class="{{ strong }}">webviews encapsulées</strong> : lente, peu adaptée au mobile et souvent instable.
    </p>
    <p class="text-on-surface-muted mb-3 leading-relaxed">
        Conséquences : des <strong class="{{ strong }}">notes faibles</strong> sur l’App Store et Google Play,
        des utilisateurs qui préféraient la version desktop, et un support très sollicité par les bugs et les problèmes d’ergonomie.
    </p>
    <p class="text-on-surface-muted leading-relaxed">
        <strong class="{{ strong }}">L’enjeu</strong> : offrir une vraie expérience mobile au public de la plateforme,
        qui génère environ <strong class="{{ strong }}">500k visites par mois</strong>.
    </p>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:user-circle', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Mon rôle : Product Owner de la refonte
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        L’application a été reconstruite entièrement avec <strong class="{{ strong }}">Flutter</strong>, à la place des webviews.
        J’ai porté le projet côté produit, de l’audit de l’existant au suivi de la réalisation.
    </p>

    <div class="space-y-6">
        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:search-01', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 1 : Auditer l’application existante
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span>Identifier les <strong class="{{ strong }}">fonctionnalités essentielles</strong> à conserver.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span>Repérer les <strong class="{{ strong }}">points de friction</strong> pour les utilisateurs.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span>Lister les <strong class="{{ strong }}">améliorations possibles</strong>, comme l’onboarding ou les empty states.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:paint-board', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 2 : Prototyper et tester
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Prototypes interactifs</strong> dans Figma, avec des composants et leurs variantes.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Tests des maquettes</strong> avec de vrais utilisateurs.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Une charte UX cohérente</strong> : couleurs, typographie, interactions.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:note-edit', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 3 : Rédiger les user stories
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">User stories</strong> détaillées pour cadrer chaque fonctionnalité.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Entretiens</strong> pour affiner les besoins, et synthèse des retours pour prioriser.</span>
                </li>
            </ul>
        </div>

        <div class="case-step">
            <h3 class="text-lg font-semibold text-accent-text mb-2 flex items-center gap-2">
                {{ ux_icon('hugeicons:agreement-01', { class: 'text-base', 'aria-hidden': 'true' }) }}
                Étape 4 : Suivre la réalisation
            </h3>
            <ul class="space-y-2">
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Synchronisation</strong> avec les équipes techniques.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Priorisation</strong> des fonctionnalités selon leur impact pour les utilisateurs.</span>
                </li>
                <li class="flex items-start gap-2 text-on-surface-muted">
                    {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                    <span><strong class="{{ strong }}">Tests de non-régression</strong> avant chaque livraison.</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="mt-8">
        <p class="mb-3 flex items-center gap-2 font-mono text-[13px] text-on-surface-muted">
            {{ ux_icon('hugeicons:toolbox', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Outils utilisés
        </p>
        <div class="case-tools">
            <span title="Figma">{{ ux_icon('logos:figma', { class: 'w-6 h-6' }) }}</span>
            <span title="Jira">{{ ux_icon('logos:jira', { class: 'w-6 h-6' }) }}</span>
            <span title="Flutter">{{ ux_icon('logos:flutter', { class: 'w-6 h-6' }) }}</span>
        </div>
    </div>
</section>

<section>
    <h2 class="{{ h2 }} flex items-center gap-2">
        {{ ux_icon('hugeicons:rocket-01', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }}
        Le résultat : une app que les utilisateurs ont adoptée
    </h2>
    <p class="text-on-surface-muted mb-6 leading-relaxed">
        La nouvelle application a remplacé l’ancienne version, avec une expérience pensée pour le mobile.
    </p>

    <div class="case-card mb-8">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:chart-increase', { class: 'text-base', 'aria-hidden': 'true' }) }}
            Résultats
        </h3>
        <ul class="space-y-2">
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">De meilleures notes</strong> sur l’App Store et Google Play.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Moins de tickets support</strong> liés aux bugs et à l’ergonomie.</span>
            </li>
            <li class="flex items-start gap-2 text-on-surface-muted">
                {{ ux_icon(check, { class: 'text-accent-text text-base shrink-0 mt-0.5', 'aria-hidden': 'true' }) }}
                <span><strong class="{{ strong }}">Un retour vers le mobile</strong> : les utilisateurs ont repris l’application plutôt que la version desktop.</span>
            </li>
        </ul>
    </div>

    <div class="story-visual">
        <h3 class="text-lg font-semibold text-accent-text mb-3 flex items-center gap-2">
            {{ ux_icon('hugeicons:image-03', { class: 'text-accent-text text-xl', 'aria-hidden': 'true' }) }} En images : la nouvelle app
        </h3>
        <div class="visual-grid">
            <div class="visual-item">
                <img
                    src="/images/experience/app-mobile-screens.webp"
                    alt="Capture d'écran de l'app mobile après refonte"
                    loading="lazy"
                    width="800"
                    height="450"
                    class="mx-auto">
                <p class="case-caption"><strong>Une interface repensée</strong> pour le mobile.</p>
            </div>
            <div class="visual-item">
                <img
                    src="/images/experience/app-mobile-onboarding-slides.webp"
                    alt="Slides d'onboarding de l'app mobile"
                    loading="lazy"
                    width="800"
                    class="mx-auto">
                <p class="case-caption"><strong>Un onboarding</strong> pour guider les nouveaux utilisateurs.</p>
            </div>
            <div class="visual-item">
                <img
                    src="/images/experience/app-mobile-empty-states.webp"
                    alt="Empty state de l'app mobile"
                    loading="lazy"
                    width="800"
                    class="mx-auto">
                <p class="case-caption"><strong>Des empty states explicites</strong>, qui indiquent quoi faire ensuite.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}
