{% extends 'layout.html.twig' %}

{# Expérience — see docs/style-guide.md § Experience timeline #}

{% block meta_description %}
Découvrez mon parcours professionnel : {{ page_manager.getNbYearsExperience() }} ans dans le web, du développement au rôle de Product Owner technique, à la croisée du produit et de la technique.
{% endblock %}

{% block body %}
<div class="font-sans text-base leading-relaxed text-on-surface">
    <section class="mx-auto max-w-[1140px] px-6 pt-18 pb-8" aria-label="Mes expériences">
        <ol class="experience-timeline relative flex flex-col gap-7">
            {% for experience in experiences_list %}
            <li id="{{ experience.slug }}" class="experience-item scroll-mt-28 md:grid md:grid-cols-[112px_minmax(0,1fr)] md:gap-6">
                {{ include('components/experience_item.html.twig', { experience: experience }) }}
            </li>
            {% endfor %}
        </ol>
    </section>

    <section class="mx-auto max-w-[1240px] px-6 pt-16 pb-22" aria-labelledby="work-lessons">
        <h2 id="work-lessons" class="mb-6 font-mono text-[13px] text-accent-text">Ce que mon parcours m’a appris</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
            {% for card in [
                { icon: 'hugeicons:search-02', title: 'Tester tôt sur le terrain', text: 'La phase pilote de Timesheet avec 4 clients et les prototypes testés pour l’app mobile m’ont appris qu’un produit s’affine sur le terrain, pas dans un document.' },
                { icon: 'hugeicons:laptop-programming', title: 'Connaître le coût d’une décision', text: 'Plus de dix ans de développement me permettent de prioriser en sachant ce qu’une fonctionnalité demande vraiment à l’équipe technique.' },
                { icon: 'hugeicons:task-01', title: 'Rendre les choses traçables', text: 'Un référentiel de fonctionnalités, une discovery outillée, un backlog structuré : ce qui est écrit et partagé se discute, se priorise et se livre mieux.' },
            ] %}
            <article class="rounded-[14px] border border-border bg-panel p-7 transition duration-300 ease-out hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] motion-safe:hover:-translate-y-1 dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]">
                {{ ux_icon(card.icon, { class: 'mb-4 block size-7 text-icon-muted', 'aria-hidden': 'true' }) }}
                <h3 class="mb-2 text-[22px] font-semibold text-title">{{ card.title }}</h3>
                <p class="text-on-surface-muted">{{ card.text }}</p>
            </article>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
