{% extends 'layout.html.twig' %}

{# Expérience — see docs/style-guide.md § Experience timeline #}

{% block meta_description %}
Découvrez mon parcours professionnel : {{ page_manager.getNbYearsExperience() }} ans dans le web, du développement au rôle de Product Owner technique, à la croisée du produit et de la technique.
{% endblock %}

{% block body %}
<div class="font-sans text-base leading-relaxed text-on-surface">
    <section class="mx-auto max-w-[1140px] px-6 pt-18 pb-8" aria-label="Mes expériences">
        <ol class="experience-timeline relative flex flex-col gap-7">
            {% for experience in experiences_list %}
            <li id="{{ experience.slug }}" class="experience-item scroll-mt-28 md:grid md:grid-cols-[112px_minmax(0,1fr)] md:gap-6">
                {{ include('components/experience_item.html.twig', { experience: experience }) }}
            </li>
            {% endfor %}
        </ol>
    </section>

    <section class="mx-auto max-w-[1240px] px-6 pt-16 pb-22" aria-labelledby="work-approach">
        <h2 id="work-approach" class="mb-6 font-mono text-[13px] font-normal text-accent-text">Ma façon de travailler</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
            {% for card in [
                { icon: 'hugeicons:user-group-03', title: 'Construire collectivement', text: 'J’apprécie les environnements collaboratifs où chacun contribue à faire avancer le produit.' },
                { icon: 'hugeicons:link-01', title: 'Faire le lien', text: 'Créer des passerelles entre technique, produit et utilisateurs fait partie de ce qui me motive.' },
                { icon: 'hugeicons:healtcare', title: 'Concevoir avec sens', text: 'Je porte une attention particulière à la clarté des interfaces et des parcours.' },
            ] %}
            <article class="rounded-[14px] border border-border bg-panel p-7 transition duration-300 ease-out hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] motion-safe:hover:-translate-y-1 dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]">
                {{ ux_icon(card.icon, { class: 'mb-4 size-8 text-accent-text', 'aria-hidden': 'true' }) }}
                <h3 class="mb-2 text-[22px] font-bold">{{ card.title }}</h3>
                <p class="text-on-surface-muted">{{ card.text }}</p>
            </article>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
