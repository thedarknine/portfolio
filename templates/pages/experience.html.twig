{% extends 'layout.html.twig' %}

{% block title %}Expérience{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/experience.css') }}">
{% endblock %}

{% block page_hero %}
    {{ include('blocks/page_hero.html.twig', { pagetitle: 'Expérience', subtitle: 'Du code au réel : des expériences qui comptent', slug: 'experience' }) }}
{% endblock %}

{% block page_quote %}
    {{ include('blocks/page_quote.html.twig', { quote: 'Toujours motivée par l’envie d’apprendre, de concevoir et de faire évoluer les idées en expériences concrètes.' }) }}
{% endblock %}

{% block body %}
    <section class="nine-experience-timeline">
        <div class="max-w-5xl mx-auto py-10">
        {% for experience in data.experiencesList %}
            {{ include('blocks/experience_item.html.twig', { experience: experience }) }}
        {% endfor %}
        </div>
    </section>

    {# WORK APPROACH #}
    <section class="nine-work-approach">
        <div class="container">
            <p class="text-center text-lg uppercase tracking-widest text-slate-500 mb-6">Ma façon de travailler</p>
