{% extends 'layout.html.twig' %}

{% block title %}Compétences{% endblock %}

{% block body %}
{% for type in skill_types_list %}
    <section class="{% if loop.index is even %}bg-surface-alt{% else %}bg-surface{% endif %} py-16 overflow-hidden">
        <div class="max-w-6xl mx-auto px-4 flex flex-col lg:flex-row gap-12 items-start">

            {# LEFT BLOCK #}
            <div class="w-full lg:w-1/4 lg:sticky lg:top-20 flex flex-col justify-between group animate__animated" data-animate="animate__fadeInLeft" data-delay="600">
                <div>
                    <h3 class="font-accent text-2xl md:text-3xl font-medium text-nine-blue-600 dark:text-nine-gray-400 tracking-tight mb-4 group-hover:text-nine-cyan-500 transition-colors">
                        {{ type.name }}
                    </h3>
                    <div class="h-1 w-12 bg-nine-cyan-500 mb-6 rounded-full transition-all duration-300 group-hover:w-20"></div>
                    <p class="{% if loop.index is even %}text-on-surface-alt/90{% else %}text-on-surface/90{% endif %} leading-relaxed font-normal text-sm mb-6">
                        {{ type.description|raw }}
                    </p>
                </div>

                <div class="hidden lg:block mt-4 opacity-40 group-hover:opacity-80 transition-opacity duration-500 transform -rotate-6 group-hover:rotate-0">
                    <img src="{{ absolute_url('images/skills/' ~ type.logo) }}" alt="{{ type.name }}" class="max-w-[160px] h-auto object-contain">
                </div>
            </div>

            {# RIGHT BLOCK : The skills grid #}
            <div class="w-full lg:w-3/4 animate__animated" data-animate="animate__fadeInRight" data-delay="600">
                {% set skills = skills_list[type.slug] %}

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                    {% for skill in skills %}
                    <div class="group/card bg-surface-card rounded-lg p-5 shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">

                        <div>
                            <div class="flex items-center gap-3.5 mb-4">
                                <div class="w-12 h-12 shrink-0 p-2 rounded-lg flex items-center justify-center group-hover/card:bg-nine-gray-200 dark:group-hover/card:bg-nine-sand-200 group-hover/card:border-nine-cyan-500/40 transition-colors duration-300">
                                    <img src="{{ absolute_url('images/skills/' ~ skill.slug ~ '.png') }}" class="w-full h-full object-contain" alt="{{ skill.name }}" />
                                </div>
                                <div>
                                    <h6 class="font-accent text-xl font-medium text-nine-cyan-500 transition-colors duration-300">
                                        {{ skill.name|raw }}
                                    </h6>

                                    <span class="text-[10px] font-semibold uppercase tracking-wider text-nine-gray-400">
                                        {% if skill.level >= 8 %}
                                            Expert
                                        {% elseif skill.level >= 6 %}
                                            Avancé
                                        {% else %}
                                            Maîtrisé
                                        {% endif %}
                                    </span>
                                </div>
                            </div>

                            <div class="w-full bg-nine-sand-200 dark:bg-nine-gray-600/20 h-1 rounded-full overflow-hidden mb-2">
                                <div style="width: {{ skill.level * 10 }}%" class="h-full bg-gradient-to-r from-nine-amber-400/40 to-nine-amber-600 transition-all duration-1000 group-hover/card:bg-nine-cyan-500"></div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-t border-nine-sand-200/50 dark:border-nine-gray-600/50 flex items-center justify-between text-[11px] text-nine-gray-400 dark:text-nine-gray-600">
                            <span class="font-medium inline-flex items-center gap-1">
                                {{ ux_icon('hugeicons:timer-02', { class: 'w-3.5 h-3.5 text-nine-gray-400/60 dark:text-nine-sand-200/60' }) }}
                                Pratique
                            </span>
                            <span class="font-bold text-nine-blue-400 dark:text-nine-gray-400 uppercase tracking-wide">
                                {% if skill.duration is not empty %}
                                    {{ skill.duration }}
                                {% else %}
                                    <span class="text-nine-blue-400 italic font-normal normal-case">En cours...</span>
                                {% endif %}
                            </span>
                        </div>

                    </div>
                    {% endfor %}
                </div>

            </div>
        </div>
    </section>
{% endfor %}

{% endblock %}
