{% extends 'layout.html.twig' %}

{# Créations — see docs/style-guide.md § Galleries #}

{% block meta_description %}
Mes créations graphiques et visuelles : illustrations, designs UI et projets créatifs qui complètent mon expertise technique et produit.
{% endblock %}

{% block importmap %}
{{ parent() }}
{{ importmap('gallery') }}
{% endblock %}

{% block body %}
<div class="font-sans text-base leading-relaxed text-on-surface">
    {% for type in creations_data.types %}
    {% set items = [] %}
    {% for creation in creations_data.creations[type.slug] ?? [] %}
    {% set items = items|merge([{ src: asset('images/creations/' ~ type.slug ~ '/' ~ creation), alt: type.name ~ ' — création ' ~ loop.index }]) %}
    {% endfor %}
    {% if items is not empty %}
    {{ include('components/gallery_section.html.twig', { index: loop.index, slug: type.slug, title: type.name, items: items }) }}
    {% endif %}
    {% endfor %}
</div>
{% endblock %}
