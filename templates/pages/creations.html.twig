{% extends 'layout.html.twig' %}

{% block title %}Créations{% endblock %}

{% block body %}
{% for type in creations_data.types %}
<section class="{% if loop.index is even %}bg-nine-golden{% else %}bg-white{% endif %} py-10">
    <div class="container">
        <h3 class="my-10 text-2xl font-accent font-medium text-nine-turquoise">{{ type.name }}</h3>
        {% set listItemsCreations = creations_data.creations[type.slug] %}
        <div class="grid grid-flow-row grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8 pswp9-lightbox">
            {% for creation in listItemsCreations %}
                <div class="w-full h-full rounded overflow-hidden shadow-lg animate__animated" data-animate="animate__zoomIn" data-delay="{{ loop.index * 0.4 }}s">
                    <a href="{{ absolute_url('images/creations/' ~ type.slug ~ '/' ~ creation) }}" aria-label="{{ type.name }} | Création {{ creation }}" class="pswp9-link" data-pswp-width="1000" data-pswp-height="1000" target="_blank">
                        <img src="{{ absolute_url('images/creations/' ~ type.slug ~ '/' ~ creation) }}" alt="" class="block w-full rounded-lg my-4 lg:my-0 object-center hover:scale-110 transition duration-500">
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endfor %}
{% endblock %}
