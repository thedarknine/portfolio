{% extends 'layout.html.twig' %}

{# Créations — see docs/style-guide.md § Galleries #}

{% block meta_description %}
Mes créations en argile depuis 2010 : sculptures et pièces modelées, mates, cirées, peintes ou vernies, et mes essais au tour.
{% endblock %}

{% block importmap %}
{{ parent() }}
{{ importmap('gallery') }}
{% endblock %}

{% block body %}
<div class="font-sans text-base leading-relaxed text-on-surface">
    <section class="mx-auto max-w-[1240px] px-6 pt-18" aria-label="Introduction">
        <p class="text-lg text-on-surface-muted">
            Je modèle l’argile depuis 2010, en autodidacte. Ce qui me plaît, c’est de travailler la matière avec les mains : un vrai moment de déconnexion, loin des écrans.
        </p>
    </section>
    {# Count the sections actually shown: a type without images is skipped #}
    {% set shown = 0 %}
    {% for type in creations_data.types %}
    {% set items = [] %}
    {% for creation in creations_data.creations[type.slug] ?? [] %}
    {% set items = items|merge([{ src: asset('images/creations/' ~ type.slug ~ '/' ~ creation), alt: type.name ~ ' — création ' ~ loop.index }]) %}
    {% endfor %}
    {% if items is not empty %}
    {% set shown = shown + 1 %}
    {{ include('components/gallery_section.html.twig', { index: shown, slug: type.slug, title: type.name, items: items }) }}
    {% endif %}
    {% endfor %}
</div>
{% endblock %}
