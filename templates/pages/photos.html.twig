{% extends 'layout.html.twig' %}

{% block title %}Photos{% endblock %}

{% block page_hero %}
    {{ include('blocks/page_hero.html.twig', { pagetitle: 'Photos', subtitle: 'Capturer des instants, des lumières, des détails', slug: 'photos' }) }}
{% endblock %}

{% block page_quote %}
    {{ include('blocks/page_quote.html.twig', { quote: 'Des fragments de moments figés.' }) }}
{% endblock %}

{% block body %}
{% for type in data.photoTypesList %}
<section class="{% if loop.index is even %}bg-nine-golden{% else %}bg-white{% endif %} py-10">
    <div class="container">
        <h3 class="my-10 text-2xl font-accent font-semibold text-nine-turquoise">{{ type.name }}</h3>
        {% set listItemsPhotos = data.photosList[type.label] %}
        <div class="grid grid-flow-row grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-8">
            {% for photo in listItemsPhotos %}
                <div class="shadow-lg mb-4">
                    <div>
                        <a href="{{ absolute_url('images/photos/' ~ type.label ~ '/' ~ photo.filename) }}" class="glightbox9" data-gallery="gallery{{ type.id }}" data-title="{{ photo.caption }}" data-desc-position="right">
                            <img src="{{ absolute_url('images/photos/' ~ type.label ~ '/' ~ photo.filename) }}" alt="" class="rounded-lg">
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endfor %}
{% endblock %}
