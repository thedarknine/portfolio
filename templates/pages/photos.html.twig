{% extends 'layout.html.twig' %}

{# Photos — see docs/style-guide.md § Galleries #}

{% block meta_description %}
Ma galerie photo personnelle : paysages inspirants et instants capturés au fil du temps. Un regard différent sur le monde, en dehors du numérique.
{% endblock %}

{% block importmap %}
{{ parent() }}
{{ importmap('gallery') }}
{% endblock %}

{% block body %}
<div class="font-sans text-base leading-relaxed text-on-surface">
    {% for type in photos_data.types %}
    {% set items = [] %}
    {% for photo in photos_data.photos[type.slug] ?? [] %}
    {% set items = items|merge([{ src: asset('images/photos/' ~ type.slug ~ '/' ~ photo.filename), alt: photo.caption ?: type.name ~ ' — photo ' ~ loop.index, caption: photo.caption }]) %}
    {% endfor %}
    {% if items is not empty %}
    {{ include('components/gallery_section.html.twig', { index: loop.index, slug: type.slug, title: type.name, items: items }) }}
    {% endif %}
    {% endfor %}
</div>
{% endblock %}
