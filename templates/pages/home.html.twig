{% extends 'layout.html.twig' %}

{# Homepage — see docs/style-guide.md #}

{% block body %}
{% set current_experience = last_experiences|first %}
{% set nb_years = page_manager.getNbYearsExperience() %}
<div class="font-sans text-base leading-relaxed text-on-surface">

    {# HERO — full-bleed photo, the header floats over it (header_controller.js) #}
    <section class="home-hero relative overflow-hidden bg-[#0f2238]">
        <img class="absolute inset-0 size-full object-cover object-[60%_60%]" src="{{ asset('images/volcans-cnoyer.webp') }}" alt="" width="1920" height="1309" fetchpriority="high">
        <div class="home-hero__overlay absolute inset-0" aria-hidden="true"></div>

        <div class="relative mx-auto flex max-w-[1240px] flex-wrap items-end justify-between gap-12 px-6 pt-40 pb-24 lg:pt-44 lg:pb-28">
            <div class="home-hero__content min-w-0 flex-[1_1_520px] lg:max-w-[620px]">
                {% if current_experience and current_experience.endDate is null %}
                <p class="mb-7 inline-flex items-center gap-2 rounded-2xl border border-border bg-panel px-3.5 py-1.5 font-mono text-[13px]">
                    <span class="size-2 shrink-0 rounded-full bg-status-live" aria-hidden="true"></span>
                    <span>Actuellement {{ current_experience.title }} chez {{ current_experience.company.name }}</span>
                </p>
                {% endif %}
                <h1 class="mb-6 text-[clamp(40px,6vw,68px)] leading-[1.04] font-bold tracking-[-1.5px] text-title">
                    Je fais le lien entre <span class="text-cyan">le métier</span> et <span class="text-cyan">la technique.</span>
                </h1>
                <p class="mb-9 max-w-[540px] text-lg text-on-surface-muted">
                    Dans le web depuis {{ nb_years }} ans, j’ai longtemps codé avant de passer côté produit en 2019. Aujourd’hui, je cadre, je priorise et j’aide les équipes à livrer ce qui compte, avec rigueur et une touche d’humour.
                </p>
                <div class="flex flex-wrap gap-3">
                    <a class="btn btn--primary" href="{{ path('app_experience') }}">
                        {{ ux_icon('hugeicons:search-01', { 'aria-hidden': 'true' }) }}
                        Découvrir mon parcours
                    </a>
                    <a class="btn btn--secondary" href="{{ cv_url }}" target="_blank" rel="noopener">
                        {{ ux_icon('hugeicons:download-04', { 'aria-hidden': 'true' }) }}
                        Télécharger mon CV
                    </a>
                </div>
            </div>

            <aside class="w-full max-w-[320px] overflow-hidden lg:self-start rounded-2xl border border-border-strong bg-panel text-on-surface shadow-[0_24px_48px_-24px_rgb(0_0_0/55%)]" aria-label="Fiche profil">
                <div class="flex items-center justify-between border-b border-border bg-panel-head px-4 py-3 font-mono text-xs text-on-surface-muted">
                    <span>profil.yaml</span><span>{{ site_version }}</span>
                </div>
                <dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-2.5 px-4 pt-3 pb-4 font-mono text-[13px] text-title">
                    <dt class="text-icon-muted">base</dt>
                    <dd>Auvergne · remote</dd>
                    <dt class="text-icon-muted">depuis</dt>
                    <dd>{{ page_manager.getStartCareerYear() }} dans le web</dd>
                    <dt class="text-icon-muted">stack</dt>
                    <dd class="flex flex-wrap gap-1.5">
                        {% for tech in ['Symfony', 'PHP', 'n8n'] %}
                        <span class="rounded-md bg-chip px-2 py-0.5 text-on-chip">{{ tech }}</span>
                        {% endfor %}
                    </dd>
                </dl>
            </aside>
        </div>
    </section>

    {# POSITIONNEMENT #}
    <section class="bg-surface-alt-brand" aria-labelledby="home-positioning">
        <div class="mx-auto max-w-[1240px] px-6 pt-22 pb-24">
            <p class="mb-2 font-mono text-[13px] text-accent-text">Positionnement</p>
            <h2 id="home-positioning" class="mb-8 text-title text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px]">Penser le produit, <span class="text-cyan">comprendre la technique</span></h2>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
                {% for card in [
                { icon: 'hugeicons:route-01', title: 'Mon parcours', text: 'Je sais ce qu’une story coûte à développer, et pourquoi elle compte pour l’utilisateur. Je connais les deux côtés de la table.', link: path('app_experience'), cta: 'Découvrir mon parcours' },
                { icon: 'hugeicons:wrench-01', title: 'Mon expertise', text: 'J’aide les équipes à cadrer les besoins, à faire les bons choix techniques et à mieux travailler ensemble.', link: path('app_skills'), cta: 'Voir mes compétences' },
                { icon: 'hugeicons:layers-01', title: 'Mon approche', text: 'J’aime comprendre, structurer et donner forme aux idées. En produit, en code ou en création, je cherche la simplicité.', link: path('app_projects'), cta: 'Voir mes réalisations' },
            ] %}
                <article class="rounded-[14px] border border-border bg-panel p-7 transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]">
                    {{ ux_icon(card.icon, { class: 'mb-5 block size-7 text-icon-muted', 'aria-hidden': 'true' }) }}
                    <h3 class="mb-2 text-[22px] font-semibold text-title">{{ card.title }}</h3>
                    <p class="mb-5 text-on-surface-muted">{{ card.text }}</p>
                    <a class="inline-flex min-h-11 items-center gap-2 font-medium text-accent-text hover:underline" href="{{ card.link }}">
                        {{ card.cta }} {{ ux_icon('hugeicons:arrow-right-02', { class: 'size-[18px]', 'aria-hidden': 'true' }) }}
                    </a>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# EXPÉRIENCES #}
    <section class="bg-band py-22 text-on-band-muted" aria-labelledby="home-experiences">
        <div class="mx-auto max-w-[1240px] px-6">
            <div class="mb-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
                <div>
                    <p class="mb-2 font-mono text-[13px] text-band-accent">Expériences</p>
                    <h2 id="home-experiences" class="text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px] text-on-band">Mes derniers postes</h2>
                </div>
                <a class="inline-flex min-h-11 items-center font-medium text-band-accent hover:underline" href="{{ path('app_experience') }}">Tout mon parcours, depuis {{ page_manager.getStartCareerYear() }} →</a>
            </div>
            <div class="flex flex-col gap-3">
                {% for experience in last_experiences %}
                {% set is_current = experience.endDate is null %}
                <article class="flex flex-wrap gap-x-8 gap-y-3 rounded-xl border border-band-border p-6 transition duration-300 ease-out motion-safe:hover:translate-x-1.5 hover:border-band-accent {{ is_current ? 'border-[1.5px] border-band-accent bg-band-card' : '' }}">
                    <div class="flex flex-[0_0_170px] flex-col gap-2">
                        {% if is_current %}
                        <span class="self-start rounded-md bg-highlight px-2.5 py-0.5 font-mono text-[13px] font-medium text-on-highlight">v{{ experience.startDate|date('Y') }} · actuel</span>
                        {% else %}
                        <span class="self-start rounded-md bg-tag px-2.5 py-0.5 font-mono text-[13px] text-on-band">v{{ experience.startDate|date('Y') }}</span>
                        {% endif %}
                        <span class="font-mono text-[13px]">{{ experience.company.name }}</span>
                    </div>
                    <div class="min-w-0 flex-[1_1_420px]">
                        <h3 class="mb-1.5 text-xl font-semibold text-on-band">{{ experience.subtitle }}</h3>
                        <p class="mb-1 font-mono text-[13px] text-band-accent">{{ experience.title }}</p>
                        {% if experience.summary %}
                        <p>{{ experience.summary }}</p>
                        {% endif %}
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# À PROPOS #}
    <section class="mx-auto max-w-[1240px] px-6 py-24" aria-labelledby="home-about">
        <div class="flex flex-wrap items-start gap-12">
            <div class="flex-[0_1_320px]">
                <img class="aspect-square w-full rounded-2xl border border-border object-cover" src="{{ asset('images/cnoyer.webp') }}" alt="Caroline Noyer" width="320" height="320" loading="lazy">
            </div>
            <div class="min-w-0 flex-[1_1_520px]">
                <p class="mb-2 font-mono text-[13px] text-accent-text">À propos</p>
                <h2 id="home-about" class="mb-6 text-title text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px]">Développeuse d’abord, Product Owner aujourd’hui</h2>
                <div class="flex flex-col gap-4 text-on-surface-muted">
                    <p>
                        J’ai commencé dans le web il y a {{ nb_years }} ans, en écrivant du code. Pendant des années, j’ai été
                        <strong class="text-on-surface">développeuse PHP</strong>, jusqu’à un poste de senior dans l’équipe R&amp;D de Coffreo.
                    </p>
                    <p>
                        En 2019, je suis passée côté produit comme <strong class="text-on-surface">Product Owner</strong>. Ce que le code m’avait appris m’a suivie :
                        une fonctionnalité bien construite ne vaut rien si elle ne répond pas au bon besoin. Aujourd’hui, je cadre et je priorise
                        en sachant ce que mes choix coûtent à l’équipe technique, et je parle le même langage qu’elle.
                    </p>
                    <p>Deux choses comptent pour moi dans un projet :</p>
                    <ul class="flex flex-col gap-3">
                        <li class="rounded-xl border border-border bg-panel p-4 transition duration-300 ease-out motion-safe:hover:translate-x-1.5">
                            <strong class="text-on-surface">L’équipe avant les individus.</strong> Une équipe qui se parle et qui rit de temps en temps
                            livre mieux qu’une addition de bons profils. J’y fais attention autant qu’au backlog.
                        </li>
                        <li class="rounded-xl border border-border bg-panel p-4 transition duration-300 ease-out motion-safe:hover:translate-x-1.5">
                            <strong class="text-on-surface">Apprendre en continu.</strong> Curieuse de nature, je vois chaque défi comme un terrain d’apprentissage.
                            Un nouvel outil, une méthode, un workflow à simplifier : j’aime comprendre comment les choses marchent, puis les améliorer.
                        </li>
                    </ul>
                    <p>
                        <strong class="text-on-surface">Ce qui me motive :</strong> les sujets où il faut à la fois de la rigueur technique et de l’écoute.
                    </p>
                </div>
            </div>
        </div>
    </section>

    {# À CÔTÉ DU TRAVAIL #}
    <section class="mx-auto max-w-[1240px] px-6 pb-24" aria-labelledby="home-side">
        <p class="mb-2 font-mono text-[13px] text-accent-text">À côté du travail</p>
        <h2 id="home-side" class="mb-8 text-title text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px]">Ce que je fais pour le plaisir</h2>
        <div class="grid auto-rows-[220px] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {# Borne d’arcade : grande carte avec photo #}
            <a class="group row-span-2 flex flex-col gap-4 rounded-[14px] border border-border bg-panel p-6 text-on-surface hover:border-accent-text transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="{{ path('app_arcade') }}">
                <span class="font-mono text-[13px] text-on-surface-muted">hardware · DIY</span>
                <img class="min-h-0 w-full flex-1 rounded-[10px] bg-placeholder object-cover object-[center_45%]" src="{{ asset('images/home/side-arcade.webp') }}" alt="La borne d’arcade terminée, écran et boutons allumés" width="640" height="640" loading="lazy">
                <div>
                    <span class="block text-2xl font-semibold text-title">Ma borne d’arcade</span>
                    <span class="mt-1 block text-on-surface-muted">Construite de A à Z : caisson en bois, câblage, déco et Recalbox.</span>
                </div>
                <span class="inline-flex items-center gap-2 font-medium text-accent-text group-hover:underline">
                    Voir la construction {{ ux_icon('hugeicons:arrow-right-02', { class: 'size-[18px]', 'aria-hidden': 'true' }) }}
                </span>
            </a>

            {# Galeries : photo de couverture sous un voile bleu nuit #}
            {% for gallery in [
                { link: path('app_photos'), image: 'images/home/side-photos.webp', meta: '5 séries', title: 'Mes photos', text: 'Nature, villes, ciels et nuits' },
                { link: path('app_creations'), image: 'images/home/side-creations.webp', meta: '5 techniques', title: 'Mes créations', text: 'Sculpture en argile' },
            ] %}
            <a class="group relative isolate flex flex-col justify-between overflow-hidden rounded-[14px] p-6 text-white transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="{{ gallery.link }}">
                <img class="absolute inset-0 -z-20 size-full object-cover transition duration-500 ease-out motion-safe:group-hover:scale-105" src="{{ asset(gallery.image) }}" alt="" width="640" height="640" loading="lazy">
                <span class="absolute inset-0 -z-10 bg-linear-to-t from-[#0F2238]/95 via-[#0F2238]/70 to-[#0F2238]/25" aria-hidden="true"></span>
                <span class="self-start rounded-md bg-[#0F2238]/70 px-2 py-0.5 font-mono text-[13px] text-[#7FCFD6]">{{ gallery.meta }}</span>
                <div>
                    <span class="flex items-center gap-2 text-2xl font-semibold">
                        {{ gallery.title }} {{ ux_icon('hugeicons:arrow-right-02', { class: 'size-5 transition motion-safe:group-hover:translate-x-1', 'aria-hidden': 'true' }) }}
                    </span>
                    <span class="mt-1 block text-[#B8C6D1]">{{ gallery.text }}</span>
                </div>
            </a>
            {% endfor %}

            {# Sous le capot : mini-console #}
            <a class="group flex flex-col justify-between gap-3 rounded-[14px] bg-feature p-6 sm:col-span-2 text-white transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="https://github.com/thedarknine/portfolio" target="_blank" rel="noopener">
                <span class="font-mono text-[13px] text-band-accent">sous le capot</span>
                <div>
                    <p class="font-mono text-[15px] sm:text-[17px]"><span class="text-[#F59E0B]" aria-hidden="true">❯ </span>symfony · tailwind · docker<span class="ml-1 inline-block h-[18px] w-[9px] align-[-3px] bg-[#7FCFD6] motion-safe:animate-pulse" aria-hidden="true"></span></p>
                    <p class="mt-2 text-[#B8C6D1]">Le code de ce site est consultable sur GitHub : architecture, tests, intégration continue. Une vitrine de ma façon de coder.</p>
                </div>
                <span class="inline-flex items-center gap-2 font-medium text-band-accent group-hover:underline">
                    Voir le dépôt {{ ux_icon('hugeicons:arrow-up-right-01', { class: 'size-[18px]', 'aria-hidden': 'true' }) }}
                    <span class="sr-only">(nouvel onglet)</span>
                </span>
            </a>
        </div>
    </section>

    {# CONTACT #}
    <section class="border-t border-border py-18" aria-labelledby="home-contact">
        <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-6 px-6">
            <div class="min-w-0 flex-[1_1_420px]">
                <h2 id="home-contact" class="mb-3 text-title text-[clamp(32px,4vw,44px)] leading-[1.1] font-bold tracking-[-1px]">Envie d’en parler ?</h2>
                <p class="max-w-[520px] text-on-surface-muted">Un projet, une opportunité ou simplement l’envie d’échanger sur le produit et la technique : je serai ravie de vous répondre.</p>
            </div>
            <a class="btn btn--primary btn--lg" href="{{ path('app_contact') }}">
                {{ ux_icon('hugeicons:mail-01', { 'aria-hidden': 'true' }) }}
                Me contacter
            </a>
        </div>
    </section>
</div>
{% endblock %}
