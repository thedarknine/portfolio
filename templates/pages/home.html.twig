{% extends 'layout.html.twig' %}

{# Homepage #}

{# % block meta_description %}
15 ans en développement web, aujourd'hui Product Owner technique. Je structure des produits SaaS alignés sur les besoins métiers et techniques.
{% endblock % #}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('styles/pages/home.css') }}">
{% endblock %}

{% block importmap %}
{{ importmap(['app', 'home']) }}
{% endblock %}

{% block body %}
{# Hero section #}
<section class="nine-home-area -mt-24 pt-24 static">
    <img src="{{ asset('images/volcans-cnoyer.webp') }}" alt="Volcans d'Auvergne" class="hero-background" fetchpriority="high">
    <div class="container px-4 sm:px-8 lg:grid lg:grid-cols-2 lg:gap-x-8">
        <div class="md:pt-12">
            <div class="animate__animated animate__fadeInUp" data-delay="1000ms">
                <img class="lg:h-80 h-40 mx-auto nine-jump rounded " src="{{ absolute_url(asset('images/cnoyer-logo.webp')) }}" alt="Caroline Noyer - Logo">
            </div>
        </div>
        <div class="mb-16 mt-12 lg:mt-32 xl:mt-40 xl:mr-12">
            <div class="max-w-2xl mx-auto mb-8">
                <h1 class="text-3xl text-white lg:text-5xl lg:leading-normal mb-4 font-bold font-heading animate__animated" data-animate="animate__fadeIn" data-delay="0.5s">Passionnée par le <span class="text-turquoise">digital</span> depuis 2005</h1>
                <p class="text-nine-cyan-500 text-xl leading-relaxed animate__animated" data-animate="animate__fadeIn" data-delay="1000ms"><strong>Expérience</strong> en <span id="typedtext" class="text-white typewrite d-inline text-brand"></span></p>
            </div>
            <div class="max-w-2xl mx-auto">
                {% for resource in page_manager.getPublishedResourceLinksInHero() %}
                <span class="text-center inline-flex items-center justify-center w-12 h-12 p-3 mb-5 mr-3 nine-btn-social rounded-full border-nine-gray-400 border-2 animate__animated" data-animate="animate__bounceInRight" data-delay="{{ 500 + loop.index * 500 }}ms">
                    <a 
                        href="{{ resource.url }}" 
                        title="{{ resource.title }}" 
                        class="text-2xl" 
                        target="_blank" 
                        aria-label="{{ resource.title }}">
                        {{ ux_icon(resource.icon, { class: 'text-nine-sand-200' }) }}
                    </a>
                </span>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
<div class="relative bottom-0 z-50">
    <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-0 w-full block" viewBox="0 0 1440 320" style="height:140px;top:-139px" preserveAspectRatio="none">
        <path class="fill-surface" fill-opacity="1" d="M 0 288 L 80 288 C 160 288 320 288 480 245.3 C 640 203 800 117 960 96 C 1120 75 1280 117 1360 138.7 L 1440 160 L 1440 320 L 0 320 Z"></path>
    </svg>
</div>

{# Positionnement section #}
<section id="competences" class="bg-surface text-on-surface py-10">
    <div class="text-center max-w-2xl mx-auto mb-16 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200ms">
        <p class="nine-section-subheader">
            Mon positionnement
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold">
            Penser le produit. Comprendre la technique. Faire le lien.
        </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {# CARD #}
        <div class="group p-8 rounded-2xl backdrop-blur bg-white/70 dark:bg-white/5 border border-white/10 hover:-translate-y-2 hover:shadow-2xl transition duration-500 animate__animated" data-animate="animate__fadeInBottomLeft" data-delay="0ms">
            {# ICON #}
            <div class="mb-6 text-3xl">🧭</div>
            {# MINI TITLE #}
            <p class="text-sm text-slate-500 mb-2">Du développement au produit</p>
            {# TITLE #}
            <h3 class="text-xl font-semibold mb-4">Parcours</h3>

            {# TEXT #}
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                15 ans en développement web, aujourd’hui complétés par un rôle de Product Owner technique.
                J’interviens à la croisée du produit et de la technique pour structurer des solutions efficaces.
            </p>
            {# CTA #}
            <a href="{{ path('app_experience') }}" aria-label="En savoir plus sur mon parcours" class="mt-6 text-sm font-medium flex items-center gap-2 text-[#0C91B9] group-hover:gap-3 transition-all after:absolute after:inset-0 after:z-10">
                Découvrir mon parcours {{ ux_icon('fa7-solid:right-long', { class: 'w-4 h-4' }) }}
            </a>
        </div>

        {# CARD #}
        <div class="group p-8 rounded-2xl backdrop-blur bg-white/70 dark:bg-white/5 border border-white/10 hover:-translate-y-2 hover:shadow-2xl transition duration-500 animate__animated" data-animate="animate__fadeInBottomLeft" data-delay="400ms">
            <div class="mb-6 text-3xl">⚙️</div>
            <p class="text-sm text-slate-500 mb-2">Faire le lien métier / tech</p>
            <h3 class="text-xl font-semibold mb-4">Expertise</h3>

            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                J’accompagne les équipes pour cadrer les besoins, orienter les choix techniques et fluidifier la collaboration.
                Une approche pragmatique, centrée sur la valeur.
            </p>
            <a href="{{ path('app_skills') }}" aria-label="En savoir plus sur mon expertise" class="mt-6 text-sm font-medium flex items-center gap-2 text-[#0C91B9] group-hover:gap-3 transition-all after:absolute after:inset-0 after:z-10">
                En savoir plus {{ ux_icon('fa7-solid:right-long', { class: 'w-4 h-4' }) }}
            </a>
        </div>

        {# CARD #}
        <div class="group p-8 rounded-2xl backdrop-blur bg-white/70 dark:bg-white/5 border border-white/10 hover:-translate-y-2 hover:shadow-2xl transition duration-500 animate__animated" data-animate="animate__fadeInBottomLeft" data-delay="800ms">
            <div class="mb-6 text-3xl">✨</div>
            <p class="text-sm text-slate-500 mb-2">Structurer &amp; simplifier</p>
            <h3 class="text-xl font-semibold mb-4">Approche</h3>

            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                J’aime comprendre, structurer et donner forme aux idées.
                Que ce soit en produit, en code ou en création, je privilégie précision et simplicité.
            </p>
            <a href="{{ path('app_projects') }}" aria-label="En savoir plus sur mon approche" class="mt-6 text-sm font-medium flex items-center gap-2 text-[#0C91B9] group-hover:gap-3 transition-all after:absolute after:inset-0 after:z-10">
                Voir mes réalisations {{ ux_icon('fa7-solid:right-long', { class: 'w-4 h-4' }) }}
            </a>
        </div>
    </div>
</section>

{# Parcours section #}
<section class="bg-nine-blue-800 text-nine-gray-200 py-10">
    <div class="text-center max-w-2xl mx-auto mb-20 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200ms">
        <p class="nine-section-subheader">
            Mon parcours
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold">
            Un parcours construit sur la technique, aujourd’hui au service du produit
        </h2>
    </div>

    {# TIMELINE #}
    <div class="relative max-w-3xl mx-auto">

        {# ligne #}
        <div class="absolute left-4 top-0 w-px h-full bg-white/10"></div>

        {# ITEM #}
        <div class="relative pl-12 mb-8 group animate__animated" data-animate="animate__fadeInLeft">
            <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-amber-400 flex items-center justify-center text-nine-blue-500 text-md">
                {{ ux_icon('hugeicons:plant-04', { class: 'w-6 h-6 text-nine-blue-500' }) }}
            </div>

            <div class="p-2 rounded-2xl backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
                <h3 class="text-xl font-semibold mb-1">Développement</h3>
                <h4 class="text-md font-bold mb-2 text-nine-gray-400">Les fondations</h4>
                <p>
                    15 ans en développement web (PHP, Symfony, bases de données).<br>
                    Une expertise construite sur des projets concrets : jeux vidéo, santé, contrats courts, assets management...<br>
                    Une vision transverse des environnements techniques et métier.
                </p>
            </div>
        </div>

        <div class="relative pl-12 mb-8 group animate__animated" data-animate="animate__fadeInLeft">
            <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-amber-400 flex items-center justify-center text-nine-blue-500 text-md">
                {{ ux_icon('hugeicons:certificate-01', { class: 'w-6 h-6 text-nine-blue-500' }) }}
            </div>

            <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
                <h3 class="text-xl font-semibold mb-1">Expertise technique</h3>
                <h4 class="text-md font-bold mb-2 text-nine-gray-400">Comprendre en profondeur</h4>
                <p>
                    Architecture, performance, automatisation...<br>
                    Une maîtrise des systèmes qui permet d’anticiper les contraintes et de faire des choix solides.
                </p>
            </div>
        </div>

        <div class="relative pl-12 mb-8 group animate__animated" data-animate="animate__fadeInLeft">
            <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-amber-400 flex items-center justify-center text-nine-blue-500 text-lg">
                {{ ux_icon('hugeicons:package-moving', { class: 'w-6 h-6 text-nine-blue-500' }) }}
            </div>

            <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
                <h3 class="text-xl font-semibold mb-1">Transition produit</h3>
                <h4 class="text-md font-bold mb-2 text-nine-gray-400">Faire le lien</h4>
                <p>
                    Cadrage, priorisation, échanges avec les métiers.<br>
                    Une évolution naturelle vers un rôle d’interface entre les équipes.
                </p>
            </div>
        </div>

        <div class="relative pl-12 mb-8 group animate__animated" data-animate="animate__fadeInLeft">
            <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-amber-400 flex items-center justify-center text-nine-blue-500 text-lg">
                {{ ux_icon('hugeicons:checkmark-badge-04', { class: 'w-6 h-6 text-nine-blue-500' }) }}
            </div>

            <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
                <h3 class="text-xl font-semibold mb-1">Product Owner technique</h3>
                <h4 class="text-md font-bold mb-2 text-nine-gray-400">Structurer et livrer</h4>
                <p>
                    Pilotage produit, coordination des équipes, décisions éclairées.<br>
                    Une approche orientée valeur, impact et qualité.
                </p>
            </div>
        </div>

        <div class="relative pl-12 mb-8group animate__animated" data-animate="animate__fadeInLeft">
            <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-amber-400 flex items-center justify-center text-nine-blue-500 text-lg">
                {{ ux_icon('hugeicons:paint-board', { class: 'w-6 h-6 text-nine-blue-500' }) }}
            </div>

            <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
                <h3 class="text-xl font-semibold mb-1">Culture UX</h3>
                <h4 class="text-md font-bold mb-2 text-nine-gray-400">Penser l’expérience</h4>
                <p>
                    UX, prototypage, design produit.<br>
                    Une attention portée à la clarté, à l’usage et à la cohérence des interfaces.
                </p>
            </div>
        </div>

    </div>
</section>

{# Experience section #}
<section id="experience" class="bg-surface py-10">
    <div class="text-center max-w-2xl mx-auto mb-16 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200ms">
        <p class="nine-section-subheader">
            Mes expériences
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold">
            Des expériences où produit, technique et collaboration s’alignent pour créer de la valeur
        </h2>
    </div>

    {% for experience in last_experiences %}
    <div class="container px-4 sm:px-8 lg:grid lg:grid-cols-12 lg:gap-x-12 text-blue-dark pb-12">
        <div class="lg:col-span-5">
            <div class="mb-16 lg:mb-0 xl:mt-16 animate__animated" data-animate="animate__fadeInLeft">
                <div class="w-10/12 sm:w-12/12 mx-auto">
                    <div class="relative flex flex-col min-w-0 wrap-break-words w-full mb-6 shadow-lg rounded-lg bg-brand-{{ experience.company.slug }}">
                        <img alt="..." src="{{ absolute_url('images/company/header-' ~ experience.company.slug ~ '.webp') }}" class="w-full align-middle rounded-t-lg">
                        <blockquote class="relative p-8 mb-4">
                            <svg preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 583 95" class="absolute left-0 w-full block" style="height:95px;top:-94px">
                                <polygon points="-30,95 583,95 583,65" class="fill-brand-{{ experience.company.slug }}"></polygon>
                            </svg>
                            <h3 class="text-xl font-bold text-white">{{ experience.title }}</h3>
                            <h4 class="mb-8 font-semibold text-white/70">{{ experience.subtitle }}</h4>
                            <p class="text-md font-light mt-2 text-nine-sand-200">{{ experience.summary }}</p>
                        </blockquote>
                    </div>
                </div>
            </div>
        </div>
        <div class="lg:col-span-7">
            <div class="sm:px-8">
                <div class="mt-4 xl:mt-20 animate__animated" data-animate="animate__fadeInRight" data-delay="0.3s">
                    <ul class="space-y-3">
                        {% for item in experience.items %}
                        <li class="flex">
                            <p class="h-lh w-5.5 shrink-0 pt-1">{{ item.picto }}</p>
                            <div class="pl-4 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-xl transition duration-500">
                                <h5 class="text-xl mb-1 font-semibold text-nine-blue-500 dark:text-nine-gray-400">{{ item.title }}</h5>
                                <p class="mb-5">
                                    {{ item.details }}
                                </p>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}

    <div class="text-center mt-10 animate__animated" data-animate="animate__fadeIn">
        <a href="{{ path('app_experience') }}" aria-label="Découvrez mon parcours professionnel" class="relative inline-flex items-center justify-center px-6 py-2.5 rounded-lg bg-gray-400/60 backdrop-blur-sm text-sm font-semibold text-nine-blue shadow-sm transition-all duration-300 hover:text-white hover:shadow-md hover:-translate-y-0.5 group overflow-hidden">
            <span class="absolute inset-0 bg-gradient-to-r from-[var(--color-nine-blue-500)] to-[var(--color-nine-cyan-500)] opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-out-in z-0"></span>
            <span class="relative z-10 flex items-center gap-2">
                <span>Découvrir mon parcours</span>
                {{ ux_icon('fa7-solid:right-long', { class: 'transition-transform group-hover:translate-x-1 w-4 h-4' }) }}
            </span>
        </a>
    </div>
</section>

{# Moodboard section #}
<section id="paysage" class="bg-nine-blue-800 text-on-surface-alt py-10">
    <div class="container mx-auto py-8">
        <div class="text-center animate__animated" data-animate="animate__fadeInUp" data-delay="0.6s">
            <p class="nine-section-subheader">
                Moodboard
            </p>
        </div>
        <div class="grid-cols-4 p-8 md:space-y-0 md:grid md:gap-3 md:grid-rows-2">
            {% for landscape in mental_landscape %}
            <div class="w-full h-full rounded overflow-hidden {% if landscape.big %}col-span-2 row-span-2{% endif %} animate__animated" data-animate="animate__zoomIn" data-delay="{{ loop.index * 0.4 }}s">
                <img src="{{ absolute_url(landscape.image) }}" alt="{{ landscape.alt }}" class="block h-full w-full grayscale-50 rounded-lg my-4 lg:my-0 object-cover object-center hover:scale-110 hover:grayscale-0 transition duration-500">
            </div>
            {% endfor %}
        </div>
        <p class="col-span-4 text-center text-on-surface-muted w-3/5 mx-auto">Mon moodboard : une source d’inspiration pour allier esthétique, fonctionnalité et harmonie dans mes projets. Chaque image reflète une valeur ou une approche qui guide mon travail : la collaboration, la précision, la sérénité, et l’innovation.</p>
    </div>
</section>

{# About me section #}
<section id="about" class="bg-surface py-10">
    <div class="text-center max-w-2xl mx-auto mb-8 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200ms">
        <p class="nine-section-subheader">
            A propos de moi
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold">
            Le pont entre l’architecture technique et l’expérience utilisateur
        </h2>
    </div>

    <div class="container flex flex-wrap text-on-surface-muted">
        <div class="w-5/6 sm:w-1/3 p-6 animate__animated" data-animate="animate__zoomInUp">
            <img src="{{ absolute_url('images/cnoyer.webp') }}" alt="Caroline Noyer • Technical Product Owner &amp; Développeur web senior" class="drop-shadow-xl rounded-full w-3/4 mx-auto mt-10 nine-border-gradient">
        </div>
        <div class="w-full sm:w-2/3 p-6 mt-10 animate__animated" data-animate="animate__zoomIn">
            <p class="mb-4">
                Passionnée par le digital depuis plus de deux décennies, mon parcours est celui d’une
                évolution constante. De <strong>développeuse PHP</strong> senior au sein de la R&D de Coffreo à <strong>Product Owner</strong>,
                j’ai appris une vérité fondamentale : la technique n’est puissante que lorsqu’elle est au service
                d’une vision claire.
            </p>
            <p class="mb-4">
                Aujourd'hui, j'allie mes bases solides en ingénierie à une sensibilité de <strong>Product Designer</strong>
                pour concevoir des produits qui ne sont pas seulement fonctionnels, mais véritablement justes pour
                l’utilisateur. Ma double culture me permet de parler le langage des développeurs tout en pilotant
                la stratégie produit avec précision.
            </p>
            <p class="mb-0">
                Pour moi, un projet réussi repose sur deux piliers :
            </p>
            <ul class="list-disc list-inside mb-4">
                <li><strong>Intelligence collective</strong> : Je crois fermement que la valeur du groupe
                    dépasse la somme des talents. J’aime insuffler cette cohésion, ce dynamisme (et parfois
                    cette touche d’humour) qui transforme un backlog en une réussite commune.</li>
                <li><strong>Évolution permanente</strong> : Curieuse de nature, je vois chaque défi comme
                    un terrain d'apprentissage. Qu’il s’agisse d’optimiser un workflow ou de me former à de
                    nouvelles méthodologies d’amélioration de soi, je cherche toujours à donner du sens et de
                    l'efficience à mes actions.</li>
            </ul>
            <p class="mb-4">
                <strong>Mon moteur ?</strong> Relever des challenges qui demandent autant de rigueur technique que
                d'ouverture d'esprit pour continuer à grandir, et faire grandir vos produits.
            </p>
        </div>
    </div>
</section>

{# Section Contact #}
<section id="contact" class="bg-surface-alt text-on-surface py-16">
    <div class="max-w-4xl mx-auto text-center px-4">
        <p class="nine-section-subheader mb-4">Me contacter</p>
        <h2 class="text-3xl md:text-4xl font-semibold mb-6">
            Prêt à collaborer ?
        </h2>

        {# Texte d'introduction #}
        <p class="text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-8 leading-relaxed">
            Que ce soit pour discuter d’un projet, d’une opportunité ou simplement échanger sur le produit et la technique,
            n’hésitez pas à me contacter. Je serai ravie d’échanger avec vous.
        </p>

        {# Bouton vers la page de contact #}
        <a href="{{ path('app_contact') }}" aria-label="Me contacter" class="relative inline-flex items-center justify-center px-6 py-2.5 rounded-lg bg-gray-400/60 backdrop-blur-sm text-sm font-semibold text-nine-blue shadow-sm transition-all duration-300 hover:text-white hover:shadow-md hover:-translate-y-0.5 group overflow-hidden">
            <span class="absolute inset-0 bg-gradient-to-r from-[var(--color-nine-blue-500)] to-[var(--color-nine-cyan-500)] opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-out-in z-0"></span>
            <span class="relative z-10 flex items-center gap-2">
                <span>Me contacter</span>
                {{ ux_icon('fa7-solid:paper-plane', { class: 'transition-transform group-hover:translate-x-1 w-4 h-4' }) }}
            </span>
        </a>
    </div>
</section>
{% endblock %}
