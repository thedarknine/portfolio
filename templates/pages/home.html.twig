{% extends 'layout.html.twig' %}

{# Homepage — see docs/style-guide.md #}

{% block body %}
{% set current_experience = last_experiences|first %}
<div class="font-sans text-base leading-relaxed text-on-surface">

    {# HERO — full-bleed photo, the header floats over it (header_controller.js) #}
    <section class="home-hero relative overflow-hidden bg-[#172c49]">
        <img class="absolute inset-0 size-full object-cover object-[60%_60%]" src="{{ asset('images/volcans-cnoyer.webp') }}" alt="" width="1920" height="1309" fetchpriority="high">
        <div class="home-hero__overlay absolute inset-0" aria-hidden="true"></div>

        <div class="relative mx-auto flex max-w-[1240px] flex-wrap items-end justify-between gap-12 px-6 pt-40 pb-24 lg:pt-44 lg:pb-28">
            <div class="home-hero__content min-w-0 flex-[1_1_520px] lg:max-w-[620px]">
                {% if current_experience and current_experience.endDate is null %}
                <p class="mb-7 inline-flex items-center gap-2 rounded-2xl border border-border bg-panel px-3.5 py-1.5 font-mono text-[13px]">
                    <span class="size-2 shrink-0 rounded-full bg-status-live" aria-hidden="true"></span>
                    <span>Actuellement {{ current_experience.title }} chez {{ current_experience.company.name }}</span>
                </p>
                {% endif %}
                <h1 class="mb-6 text-[clamp(40px,6vw,68px)] leading-[1.04] font-bold tracking-[-1.5px]">
                    Je fais le lien entre <span class="text-accent-text">le métier</span> et <span class="text-accent-text">la technique.</span>
                </h1>
                <p class="mb-9 max-w-[540px] text-lg text-on-surface-muted">
                    J'ai codé pendant 15 ans avant de passer côté produit en 2019. Aujourd'hui, je cadre, je priorise et j'aide les équipes à livrer ce qui compte, avec rigueur et une touche d'humour.
                </p>
                <div class="flex flex-wrap gap-3">
                    <a class="btn btn--primary" href="{{ path('app_experience') }}">
                        Découvrir mon parcours
                        {{ ux_icon('hugeicons:arrow-right-02', { 'aria-hidden': 'true' }) }}
                    </a>
                    <a class="btn btn--secondary" href="{{ cv_url }}" target="_blank" rel="noopener">
                        {{ ux_icon('hugeicons:download-04', { 'aria-hidden': 'true' }) }}
                        Télécharger mon CV
                    </a>
                </div>
            </div>

            <aside class="w-full max-w-[320px] overflow-hidden lg:self-start rounded-2xl border border-border bg-panel text-on-surface shadow-[0_24px_48px_-24px_rgb(0_0_0/55%)]" aria-label="Fiche profil">
                <div class="flex items-center justify-between border-b border-border px-4 py-3 font-mono text-xs text-on-surface-muted">
                    <span>profil.yaml</span><span>v{{ 'now'|date('Y.m') }}</span>
                </div>
                <dl class="grid grid-cols-[max-content_minmax(0,1fr)] gap-x-4 gap-y-2.5 px-4 pt-3 pb-4 font-mono text-[13px]">
                    <dt class="text-on-surface-muted">base</dt><dd>Auvergne · remote</dd>
                    <dt class="text-on-surface-muted">depuis</dt><dd>{{ page_manager.getStartCareerYear() }} dans le web</dd>
                    <dt class="text-on-surface-muted">stack</dt>
                    <dd class="flex flex-wrap gap-1.5">
                        {% for tech in ['Symfony', 'PHP', 'n8n'] %}
                        <span class="rounded-md bg-chip px-2 py-0.5 text-on-chip">{{ tech }}</span>
                        {% endfor %}
                    </dd>
                </dl>
            </aside>
        </div>
    </section>

    {# POSITIONNEMENT #}
    <section class="mx-auto max-w-[1240px] px-6 pt-8 pb-24" aria-labelledby="home-positioning">
        <p class="mb-2 font-mono text-[13px] text-accent-text">Mon positionnement</p>
        <h2 id="home-positioning" class="mb-8 text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px]">Penser le produit. Comprendre la technique. Faire le lien.</h2>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
            {% for card in [
                { index: '01', title: 'Mon parcours', text: '15 ans de développement web, aujourd’hui au service du produit. Je connais les deux côtés de la table.', link: path('app_experience'), cta: 'Découvrir mon parcours' },
                { index: '02', title: 'Mon expertise', text: 'J’aide les équipes à cadrer les besoins, à faire les bons choix techniques et à mieux travailler ensemble.', link: path('app_skills'), cta: 'Voir mes compétences' },
                { index: '03', title: 'Mon approche', text: 'J’aime comprendre, structurer et donner forme aux idées. En produit, en code ou en création, je cherche la simplicité.', link: path('app_projects'), cta: 'Voir mes réalisations' },
            ] %}
            <article class="rounded-[14px] border border-border bg-panel p-7 transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]">
                <p class="mb-5 font-mono text-[13px] text-on-surface-muted">{{ card.index }}</p>
                <h3 class="mb-2 text-[22px] font-bold">{{ card.title }}</h3>
                <p class="mb-5 text-on-surface-muted">{{ card.text }}</p>
                <a class="inline-flex min-h-11 items-center gap-2 font-medium text-accent-text hover:underline" href="{{ card.link }}">
                    {{ card.cta }} {{ ux_icon('hugeicons:arrow-right-02', { class: 'size-[18px]', 'aria-hidden': 'true' }) }}
                </a>
            </article>
            {% endfor %}
        </div>
    </section>

    {# EXPÉRIENCES #}
    <section class="bg-band py-22 text-on-band-muted" aria-labelledby="home-experiences">
        <div class="mx-auto max-w-[1240px] px-6">
            <div class="mb-10 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-3">
                <div>
                    <p class="mb-2 font-mono text-[13px] text-band-accent">Mes expériences</p>
                    <h2 id="home-experiences" class="text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px] text-on-band">Là où produit et technique se rencontrent</h2>
                </div>
                <a class="inline-flex min-h-11 items-center font-medium text-band-accent hover:underline" href="{{ path('app_experience') }}">Tout mon parcours, depuis {{ page_manager.getStartCareerYear() }} →</a>
            </div>
            <div class="flex flex-col gap-3">
                {% for experience in last_experiences %}
                {% set is_current = experience.endDate is null %}
                <article class="flex flex-wrap gap-x-8 gap-y-3 rounded-xl border border-band-border p-6 transition duration-300 ease-out motion-safe:hover:translate-x-1.5 hover:border-band-accent {{ is_current ? 'bg-band-card' : '' }}">
                    <div class="flex flex-[0_0_170px] flex-col gap-2">
                        {% if is_current %}
                        <span class="self-start rounded-md bg-highlight px-2.5 py-0.5 font-mono text-[13px] font-medium text-on-highlight">v{{ experience.startDate|date('Y') }} · actuel</span>
                        {% else %}
                        <span class="self-start rounded-md bg-tag px-2.5 py-0.5 font-mono text-[13px] text-on-band">v{{ experience.startDate|date('Y') }}</span>
                        {% endif %}
                        <span class="font-mono text-[13px]">{{ experience.company.name }}</span>
                    </div>
                    <div class="min-w-0 flex-[1_1_420px]">
                        <h3 class="mb-1.5 text-xl font-bold text-on-band">{{ experience.subtitle }}</h3>
                        <p class="mb-1 font-mono text-[13px] text-band-accent">{{ experience.title }}</p>
                        {% if experience.summary %}
                        <p>{{ experience.summary }}</p>
                        {% endif %}
                    </div>
                </article>
                {% endfor %}
            </div>
        </div>
    </section>

    {# À PROPOS #}
    <section class="mx-auto max-w-[1240px] px-6 py-24" aria-labelledby="home-about">
        <div class="flex flex-wrap items-start gap-12">
            <div class="flex-[0_1_320px]">
                <img class="aspect-square w-full rounded-2xl border border-border object-cover" src="{{ asset('images/cnoyer.webp') }}" alt="Caroline Noyer" width="320" height="320" loading="lazy">
            </div>
            <div class="min-w-0 flex-[1_1_520px]">
                <p class="mb-2 font-mono text-[13px] text-accent-text">À propos de moi</p>
                <h2 id="home-about" class="mb-6 text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px]">Le pont entre l’architecture technique et l’expérience utilisateur</h2>
                <div class="flex max-w-[680px] flex-col gap-4 text-on-surface-muted">
                    <p>
                        Passionnée par le digital depuis plus de deux décennies, mon parcours est celui d’une évolution constante.
                        De <strong class="text-on-surface">développeuse PHP</strong> senior au sein de la R&amp;D de Coffreo à <strong class="text-on-surface">Product Owner</strong>,
                        j’ai appris une vérité fondamentale : la technique n’est puissante que lorsqu’elle est au service d’une vision claire.
                    </p>
                    <p>
                        Aujourd’hui, j’allie mes bases solides en ingénierie à une sensibilité de <strong class="text-on-surface">Product Designer</strong>
                        pour concevoir des produits qui ne sont pas seulement fonctionnels, mais véritablement justes pour l’utilisateur.
                        Ma double culture me permet de parler le langage des développeurs tout en pilotant la stratégie produit avec précision.
                    </p>
                    <p>Pour moi, un projet réussi repose sur deux piliers :</p>
                    <ul class="flex flex-col gap-3">
                        <li class="rounded-xl border border-border bg-panel p-4 transition duration-300 ease-out motion-safe:hover:translate-x-1.5">
                            <strong class="text-on-surface">Intelligence collective.</strong> Je crois fermement que la valeur du groupe dépasse la somme des talents.
                            J’aime insuffler cette cohésion, ce dynamisme (et parfois cette touche d’humour) qui transforme un backlog en une réussite commune.
                        </li>
                        <li class="rounded-xl border border-border bg-panel p-4 transition duration-300 ease-out motion-safe:hover:translate-x-1.5">
                            <strong class="text-on-surface">Évolution permanente.</strong> Curieuse de nature, je vois chaque défi comme un terrain d’apprentissage.
                            Qu’il s’agisse d’optimiser un workflow ou de me former à de nouvelles méthodologies, je cherche toujours à donner du sens et de l’efficience à mes actions.
                        </li>
                    </ul>
                    <p>
                        <strong class="text-on-surface">Mon moteur ?</strong> Relever des challenges qui demandent autant de rigueur technique que d’ouverture d’esprit,
                        pour continuer à grandir et faire grandir vos produits.
                    </p>
                </div>
            </div>
        </div>
    </section>

    {# À CÔTÉ DU TRAVAIL #}
    <section class="mx-auto max-w-[1240px] px-6 pb-24" aria-labelledby="home-side">
        <p class="mb-2 font-mono text-[13px] text-accent-text">À côté du travail</p>
        <h2 id="home-side" class="mb-8 text-[clamp(28px,3.4vw,36px)] leading-[1.15] font-bold tracking-[-0.5px]">Ce que je construis pour le plaisir</h2>
        <div class="grid auto-rows-[220px] grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
            <a class="row-span-2 flex flex-col justify-between gap-4 rounded-[14px] border border-border bg-panel p-6 text-on-surface hover:border-accent-text transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="{{ path('app_arcade') }}">
                <span class="font-mono text-[13px] text-on-surface-muted">hardware · DIY</span>
                <img class="min-h-0 w-full flex-1 rounded-[10px] bg-placeholder object-cover" src="{{ asset('images/pages/hero-arcade.webp') }}" alt="" loading="lazy">
                <span class="text-2xl font-bold">Ma borne d’arcade</span>
            </a>
            <a class="flex flex-col justify-between rounded-[14px] border border-border bg-panel p-6 text-on-surface hover:border-accent-text transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="{{ path('app_photos') }}">
                <span class="font-mono text-[13px] text-on-surface-muted">galerie</span>
                <span class="text-2xl font-bold">Mes photos</span>
            </a>
            <a class="flex flex-col justify-between rounded-[14px] border border-border bg-panel p-6 text-on-surface hover:border-accent-text transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="{{ path('app_creations') }}">
                <span class="font-mono text-[13px] text-on-surface-muted">galerie</span>
                <span class="text-2xl font-bold">Mes créations</span>
            </a>
            <a class="flex flex-col justify-between rounded-[14px] bg-primary p-6 sm:col-span-2 text-on-primary transition duration-300 ease-out motion-safe:hover:-translate-y-1 hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]" href="https://github.com/thedarknine/portfolio" target="_blank" rel="noopener">
                <span class="font-mono text-[13px]">sous le capot</span>
                <span class="text-[22px] font-bold">Ce site : Symfony, Tailwind et Docker</span>
            </a>
        </div>
    </section>

    {# CONTACT #}
    <section class="border-t border-border py-18" aria-labelledby="home-contact">
        <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-6 px-6">
            <div class="min-w-0 flex-[1_1_420px]">
                <h2 id="home-contact" class="mb-3 text-[clamp(32px,4vw,44px)] leading-[1.1] font-bold tracking-[-1px]">Envie d’en parler ?</h2>
                <p class="max-w-[520px] text-on-surface-muted">Un projet, une opportunité ou simplement l’envie d’échanger sur le produit et la technique : je serai ravie de vous répondre.</p>
            </div>
            <a class="btn btn--strong btn--lg" href="{{ path('app_contact') }}">Me contacter</a>
        </div>
    </section>
</div>
{% endblock %}
