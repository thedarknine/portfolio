{% extends 'layout.html.twig' %}

{% block title %}Technical Product Owner{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/home.css') }}">
{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'home']) }}
{% endblock %}

{% block body %}
{# Hero section #}
<section class="nine-home-area -mt-24 pt-24 static">
    <div class="container px-4 sm:px-8 lg:grid lg:grid-cols-2 lg:gap-x-8">
        <div class="md:pt-12">
            <img class="lg:h-80 h-40 mx-auto jump rounded animate__animated" data-animate="animate__fadeInUp" data-delay="1s" src="{{ absolute_url(asset('images/logo-cnoyer.webp')) }}" alt="">
        </div>
        <div class="mb-16 mt-12 lg:mt-32 xl:mt-40 xl:mr-12">
            <div class="max-w-2xl mx-auto mb-8">
                <h2 class="text-3xl text-white lg:text-5xl lg:leading-normal mb-4 font-bold font-heading animate__animated" data-animate="animate__fadeIn" data-delay="0.5s">Passionnée par le <span class="text-turquoise">digital</span> depuis 2005</h2>
                <p class="text-nine-turquoise text-xl leading-relaxed animate__animated" data-animate="animate__fadeIn" data-delay="1s" ><strong>Expérience</strong> en <span id="typedtext" class="text-white typewrite d-inline text-brand"></span></p>
            </div>
            <div class="max-w-2xl mx-auto">
                {% for resource in page_manager.getPublishedResourceLinksInHero() %}
                <span class="text-center inline-flex items-center justify-center w-12 h-12 p-3 mb-5 mr-3 nine-btn-social rounded-full border-nine-gray border-2 animate__animated" data-animate="animate__bounceInRight" data-delay="{{ 500 + loop.index * 500 }}">
                    <a href="{{ resource.url }}" title="{{ resource.title }}" class="text-2xl" target="_blank" aria-label="{{ resource.title }}"><i class="{{ resource.icon }} text-nine-light"></i></a>
                </span>
                {% endfor %}
            </div>
        </div>
    </div> {# end of container #}
</section>
<div class="relative bottom-0 z-50">
    <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-0 w-full block" viewBox="0 0 1440 320" style="height:140px;top:-139px" preserveAspectRatio="none"><path class="fill-nine-golden" fill-opacity="1" d="M 0 288 L 80 288 C 160 288 320 288 480 245.3 C 640 203 800 117 960 96 C 1120 75 1280 117 1360 138.7 L 1440 160 L 1440 320 L 0 320 Z"></path></svg>
</div>

{# Competences section #}
<section id="competences" class="bg-nine-golden py-10">
    <div class="text-center max-w-2xl mx-auto mb-16 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200">
        <p class="text-sm uppercase tracking-widest text-slate-500 mb-3">
            Mon positionnement
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold">
            Penser le produit. Comprendre la technique. Faire le lien.
        </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {# CARD #}
        <div class="group p-8 rounded-2xl backdrop-blur bg-white/70 dark:bg-white/5 border border-white/10 hover:-translate-y-2 hover:shadow-2xl transition duration-500 animate__animated" data-animate="animate__fadeInBottomLeft" data-delay="0">
            {# ICON #}
            <div class="mb-6 text-3xl" style="color:#0C91B9">🧭</div>
            {# MINI TITLE #}
            <p class="text-sm text-slate-500 mb-2">Du développement au produit</p>
            {# TITLE #}
            <h3 class="text-xl font-semibold mb-4">Parcours</h3>

            {# TEXT #}
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            15 ans en développement web, aujourd’hui complétés par un rôle de Product Owner technique.
            J’interviens à la croisée du produit et de la technique pour structurer des solutions efficaces.
            </p>
            {# CTA #}
            <a href="{{ path('app_experience') }}" aria-label="En savoir plus sur mon parcours" class="mt-6 text-sm font-medium flex items-center gap-2 text-[#0C91B9] group-hover:gap-3 transition-all after:absolute after:inset-0 after:z-10">
            En savoir plus <i class="fa-solid fa-right-long"></i>
            </a>
        </div>

        {# CARD #}
        <div class="group p-8 rounded-2xl backdrop-blur bg-white/70 dark:bg-white/5 border border-white/10 hover:-translate-y-2 hover:shadow-2xl transition duration-500 animate__animated" data-animate="animate__fadeInBottomLeft" data-delay="400">
            <div class="mb-6 text-3xl" style="color:#0C91B9">⚙️</div>
            <p class="text-sm text-slate-500 mb-2">Faire le lien métier / tech</p>
            <h3 class="text-xl font-semibold mb-4">Expertise</h3>

            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            J’accompagne les équipes pour cadrer les besoins, orienter les choix techniques et fluidifier la collaboration.
            Une approche pragmatique, centrée sur la valeur.
            </p>
            <a href="{{ path('app_skills') }}" aria-label="En savoir plus sur mon expertise" class="mt-6 text-sm font-medium flex items-center gap-2 text-[#0C91B9] group-hover:gap-3 transition-all after:absolute after:inset-0 after:z-10">
            En savoir plus <i class="fa-solid fa-right-long"></i>
            </a>
        </div>

        {# CARD #}
        <div class="group p-8 rounded-2xl backdrop-blur bg-white/70 dark:bg-white/5 border border-white/10 hover:-translate-y-2 hover:shadow-2xl transition duration-500 animate__animated" data-animate="animate__fadeInBottomLeft" data-delay="800">
            <div class="mb-6 text-3xl" style="color:#ff5e00">✨</div>
            <p class="text-sm text-slate-500 mb-2">Structurer &amp; simplifier</p>
            <h3 class="text-xl font-semibold mb-4">Approche</h3>

            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
            J’aime comprendre, structurer et donner forme aux idées.
            Que ce soit en produit, en code ou en création, je privilégie précision et simplicité.
            </p>
            <a href="{{ path('app_projects') }}" aria-label="En savoir plus sur mon approche" class="mt-6 text-sm font-medium flex items-center gap-2 text-[#0C91B9] group-hover:gap-3 transition-all after:absolute after:inset-0 after:z-10">
            En savoir plus <i class="fa-solid fa-right-long"></i>
            </a>
        </div>
    </div>
</section>

{# Parcours section #}
<section class="bg-nine-primary text-white py-10">
  <div class="text-center max-w-2xl mx-auto mb-20 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200">
    <p class="text-sm uppercase tracking-widest text-slate-500 mb-3">
      Mon parcours
    </p>
    <h2 class="text-3xl md:text-4xl font-semibold">
      Un parcours construit sur la technique, aujourd’hui au service du produit
    </h2>
  </div>

  {# TIMELINE #}
  <div class="relative max-w-3xl mx-auto">

    {# ligne #}
    <div class="absolute left-4 top-0 w-px h-full bg-slate-300 dark:bg-white/10"></div>

    {# ITEM #}
    <div class="relative pl-12 mb-12 group animate__animated" data-animate="animate__fadeInLeft">
        <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-yellow flex items-center justify-center text-blue-medium text-md">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 12V20" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 12V13H15C18.3137 13 21 10.3137 21 7V6H18C14.6863 6 12 8.68629 12 12Z" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 10V11H9C5.68629 11 3 8.31371 3 5V4H6C9.31371 4 12 6.68629 12 10Z" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <div class="p-2 rounded-2xl backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
            <h3 class="text-xl font-semibold mb-1">Développement</h3>
            <h4 class="text-md font-bold mb-2 text-turquoise">Les fondations</h4>
            <p class="text-slate-600 dark:text-slate-400">
                15 ans en développement web (PHP, Symfony, bases de données).<br>
                Une expertise construite sur des projets concrets : jeux vidéo, santé, contrats courts, assets management...<br>
                Une vision transverse des environnements techniques et métier.
            </p>
        </div>
    </div>

    <div class="relative pl-12 mb-12 group animate__animated" data-animate="animate__fadeInLeft">
        <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-yellow flex items-center justify-center text-nine-primary text-md">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.631 8.41m5.96 5.96a14.926 14.926 0 0 1-5.841 2.58m-.119-8.54a6 6 0 0 0-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 0 0-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 0 1-2.448-2.448 14.9 14.9 0 0 1 .06-.312m-2.24 2.39a4.493 4.493 0 0 0-1.757 4.306 4.493 4.493 0 0 0 4.306-1.758M16.5 9a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
            </svg>
        </div>

        <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
            <h3 class="text-xl font-semibold mb-1">Expertise technique</h3>
            <h4 class="text-md font-bold mb-2 text-turquoise">Comprendre en profondeur</h4>
            <p class="text-slate-600 dark:text-slate-400">
                Architecture, performance, automatisation...<br>
                Une maîtrise des systèmes qui permet d’anticiper les contraintes et de faire des choix solides.
            </p>
        </div>
    </div>

    <div class="relative pl-12 mb-12 group animate__animated" data-animate="animate__fadeInLeft">
        <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-yellow flex items-center justify-center text-nine-primary text-lg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2.5 12C2.5 7.52166 2.5 5.28249 3.89124 3.89124C5.28249 2.5 7.52166 2.5 12 2.5C16.4783 2.5 18.7175 2.5 20.1088 3.89124C21.5 5.28249 21.5 7.52166 21.5 12C21.5 16.4783 21.5 18.7175 20.1088 20.1088C18.7175 21.5 16.4783 21.5 12 21.5C7.52166 21.5 5.28249 21.5 3.89124 20.1088C2.5 18.7175 2.5 16.4783 2.5 12Z" stroke="#0b3476" stroke-width="1.5"/>
                <path d="M9.22687 9.22687L15 15M9.22687 9.22687C9.73219 8.72156 12.1154 9.21665 12.8351 9.22687M9.22687 9.22687C8.72156 9.73219 9.21665 12.1154 9.22687 12.8351" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
            <h3 class="text-xl font-semibold mb-1">Transition produit</h3>
            <h4 class="text-md font-bold mb-2 text-turquoise">Faire le lien</h4>
            <p class="text-slate-600 dark:text-slate-400">
                Cadrage, priorisation, échanges avec les métiers.<br>
                Une évolution naturelle vers un rôle d’interface entre les équipes.
            </p>
        </div>
    </div>

    <div class="relative pl-12 mb-12 group animate__animated" data-animate="animate__fadeInLeft">
        <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-yellow flex items-center justify-center text-nine-primary text-lg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M15 17.5C15 17.5 15.5 17.5 16 18.5C16 18.5 17.5882 16 19 15.5" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 17C22 19.7614 19.7614 22 17 22C14.2386 22 12 19.7614 12 17C12 14.2386 14.2386 12 17 12C19.7614 12 22 14.2386 22 17Z" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M15.0287 9.24471C14.4228 8.20147 13.2933 7.5 12 7.5C10.067 7.5 8.5 9.067 8.5 11C8.5 12.0657 8.97625 13.0201 9.72753 13.662" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M21.984 10.74C21.96 10.2 21.5969 9.5418 20.7906 8.15201L18.8669 4.83622C18.0638 3.45197 17.6623 2.75984 17.0019 2.37992C16.3416 2 15.5402 2 13.9373 2H10.0627C8.45982 2 7.6584 2 6.99807 2.37992C6.33774 2.75984 5.93619 3.45196 5.13311 4.83621L3.20942 8.152C2.40314 9.5418 2 10.2366 2 11C2 11.7634 2.40314 12.4582 3.20942 13.848L5.13311 17.1638C5.93619 18.548 6.33774 19.2402 6.99807 19.6201C7.62 19.92 7.99712 20 9.6 20" stroke="#0b3476" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </div>

        <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
            <h3 class="text-xl font-semibold mb-1">Product Owner technique</h3>
            <h4 class="text-md font-bold mb-2 text-turquoise">Structurer et livrer</h4>
            <p class="text-slate-600 dark:text-slate-400">
                Pilotage produit, coordination des équipes, décisions éclairées.<br>
                Une approche orientée valeur, impact et qualité.
            </p>
        </div>
    </div>

    <div class="relative pl-12 mb-12 group animate__animated" data-animate="animate__fadeInLeft">
        <div class="absolute left-0 top-1 w-8 h-8 rounded-full bg-nine-yellow flex items-center justify-center text-nine-primary text-lg">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C12.8417 22 14 22.1163 14 21C14 20.391 13.6832 19.9212 13.3686 19.4544C12.9082 18.7715 12.4523 18.0953 13 17C13.6667 15.6667 14.7778 15.6667 16.4815 15.6667C17.3334 15.6667 18.3334 15.6667 19.5 15.5C21.601 15.1999 22 13.9084 22 12Z" stroke="#0b3476" stroke-width="1.5"/>
                <path d="M7 15.002L7.00868 14.9996" stroke="#0b3476" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="9.5" cy="8.5" r="1.5" stroke="#0b3476" stroke-width="1.5"/>
                <circle cx="16.5" cy="9.5" r="1.5" stroke="#0b3476" stroke-width="1.5"/>
            </svg>
        </div>

        <div class="p-2 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-2xl transition duration-500">
            <h3 class="text-xl font-semibold mb-1">Culture UX</h3>
            <h4 class="text-md font-bold mb-2 text-turquoise">Penser l’expérience</h4>
            <p class="text-slate-600 dark:text-slate-400">
                UX, prototypage, design produit.<br>
                Une attention portée à la clarté, à l’usage et à la cohérence des interfaces.
            </p>
        </div>
    </div>

  </div>
</section>

{# Experience section #}
<section id="experience" class="bg-nine-golden py-10">
    <div class="text-center max-w-2xl mx-auto mb-16 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200">
        <p class="text-sm uppercase tracking-widest text-slate-500 mb-3">
            Mes expériences
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold">
            Des expériences où produit, technique et collaboration s’alignent pour créer de la valeur
        </h2>
    </div>

{% for experience in last_experiences %}
    <div class="container px-4 sm:px-8 lg:grid lg:grid-cols-12 lg:gap-x-12 text-blue-dark pb-12">
        <div class="lg:col-span-5">
            <div class="mb-16 lg:mb-0 xl:mt-16 animate__animated" data-animate="animate__fadeInLeft">
                <div class="w-10/12 sm:w-12/12 mx-auto">
                    <div class="relative flex flex-col min-w-0 wrap-break-words w-full mb-6 shadow-lg rounded-lg bg-{{ experience.company.slug }}">
                        <img alt="..." src="{{ absolute_url('images/company/header-' ~ experience.company.slug ~ '.webp') }}" class="w-full align-middle rounded-t-lg">
                        <blockquote class="relative p-8 mb-4">
                            <svg preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 583 95" class="absolute left-0 w-full block" style="height:95px;top:-94px"><polygon points="-30,95 583,95 583,65" class="fill-{{ experience.company.slug }}"></polygon></svg>
                            <h4 class="text-xl font-bold text-white">{{ experience.title }}</h4>
                            <h5 class="mb-8 font-semibold text-white/70">{{ experience.subtitle }}</h5>
                            <p class="text-md font-light mt-2 text-white">{{ experience.summary }}</p>
                        </blockquote>
                    </div>
                </div>
            </div>
        </div>
        <div class="lg:col-span-7">
            <div class="sm:px-8">
                <div class="mt-4 xl:mt-20 animate__animated" data-animate="animate__fadeInRight" data-delay="0.3s">
                    <ul class="space-y-3">
                        {% for item in experience.items %}
                        <li class="flex">
                            <p class="h-lh w-5.5 shrink-0 pt-1">{{ item.picto }}</p>
                            <div class="pl-4 rounded-lg backdrop-blur hover:translate-x-2 hover:shadow-xl transition duration-500">
                                <h6 class="text-xl mb-1 font-semibold text-perfect">{{ item.title }}</h6>
                                <p class="mb-5">
                                {{ item.details }}
                                </p>
                            </div>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>

{% endfor %}
    <div class="text-center mt-10 animate__animated" data-animate="animate__fadeIn">
    <a href="{{ path('app_experience') }}" aria-label="Découvrez mon parcours professionnel" class="relative inline-flex items-center justify-center px-6 py-2.5 rounded-lg bg-white/60 backdrop-blur-sm text-sm font-semibold text-nine-blue shadow-sm transition-all duration-300 hover:text-white hover:shadow-md hover:-translate-y-0.5 group overflow-hidden">
        <span class="absolute inset-0 bg-gradient-to-r from-[var(--color-nine-blue)] to-[var(--color-nine-turquoise)] opacity-0 group-hover:opacity-100 transition-opacity duration-300 ease-out-in z-0"></span>
        <span class="relative z-10 flex items-center gap-2">
            <span>En savoir plus</span>
            <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-1"></i>
        </span>
    </a>
    </div>
</section>

{# Moodboard section #}
<section id="paysage" class="bg-nine-primary text-white py-10">
    <div class="container mx-auto py-8">
        <div class="text-center animate__animated" data-animate="animate__fadeInUp" data-delay="0.6s">
            <p class="text-sm uppercase tracking-widest text-slate-500 mb-3">
                Moodboard
            </p>
        </div>
        <div class="grid-cols-4 p-8 md:space-y-0 md:grid md:gap-3 md:grid-rows-2">
            {% for landscape in mental_landscape %}
            <div class="w-full h-full rounded overflow-hidden {% if landscape.big %}col-span-2 row-span-2{% endif %} animate__animated" data-animate="animate__zoomIn" data-delay="{{ loop.index * 0.4 }}s">
                <img src="{{ absolute_url(landscape.image) }}" alt="{{ landscape.alt }}" class="block h-full w-full grayscale-50 rounded-lg my-4 lg:my-0 object-cover object-center hover:scale-110 transition duration-500">
            </div>
            {% endfor %}
        </div>
    </div>
</section>

{# About me section #}
<section id="about" class="bg-nine-golden py-10">
    <div class="text-center max-w-2xl mx-auto mb-16 animate__animated animate__slow" data-animate="animate__fadeIn" data-delay="200">
        <p class="text-sm uppercase tracking-widest text-slate-500 mb-3">
            A propos de moi
        </p>
        <h2 class="text-3xl md:text-4xl font-semibold">
            Le pont entre l’architecture technique et l’expérience utilisateur
        </h2>
    </div>

    <div class="container flex flex-wrap">
        <div class="w-5/6 sm:w-1/3 p-6 animate__animated" data-animate="animate__zoomInUp">
            <img src="{{ absolute_url('images/cnoyer.webp') }}" alt="Caroline Noyer • Technical Product Owner &amp; Développeur web senior" class="drop-shadow-xl rounded-full w-3/4 mx-auto mt-10 nine-border-gradient">
        </div>
        <div class="w-full sm:w-2/3 p-6 mt-10 animate__animated" data-animate="animate__zoomIn">
            <p class="mb-4">
                Passionnée par le digital depuis plus de deux décennies, mon parcours est celui d’une
                évolution constante. De <strong>développeuse PHP</strong> senior au sein de la R&D de Coffreo à <strong>Product Owner</strong>,
                j’ai appris une vérité fondamentale : la technique n’est puissante que lorsqu’elle est au service
                d’une vision claire.
            </p>
            <p class="mb-4">
                Aujourd'hui, j'allie mes bases solides en ingénierie à une sensibilité de <strong>Product Designer</strong>
                pour concevoir des produits qui ne sont pas seulement fonctionnels, mais véritablement justes pour
                l’utilisateur. Ma double culture me permet de parler le langage des développeurs tout en pilotant
                la stratégie produit avec précision.
            </p>
            <p class="mb-0">
                Pour moi, un projet réussi repose sur deux piliers :
            </p>
            <ul class="list-disc list-inside mb-4">
                <li><strong>Intelligence collective</strong> : Je crois fermement que la valeur du groupe
                dépasse la somme des talents. J’aime insuffler cette cohésion, ce dynamisme (et parfois
                cette touche d’humour) qui transforme un backlog en une réussite commune.</li>
                <li><strong>Évolution permanente</strong> : Curieuse de nature, je vois chaque défi comme
                un terrain d'apprentissage. Qu’il s’agisse d’optimiser un workflow ou de me former à de
                nouvelles méthodologies d’amélioration de soi, je cherche toujours à donner du sens et de
                l'efficience à mes actions.</li>
            </ul>
            <p class="mb-4">
                <strong>Mon moteur ?</strong> Relever des challenges qui demandent autant de rigueur technique que
                d'ouverture d'esprit pour continuer à grandir, et faire grandir vos produits.
            </p>
        </div>
    </div>
</section>
{% endblock %}
