{# Closing quote of inner pages — see docs/style-guide.md § Page quote #}
{% if current_page.quote %}
<section class="border-y border-border bg-panel font-sans">
    <figure class="mx-auto max-w-[900px] px-6 py-22 text-center">
        <p class="mb-2 text-[72px] leading-[0.6] font-bold text-accent-text/20" aria-hidden="true">“</p>
        <blockquote class="text-[clamp(24px,3vw,32px)] leading-[1.35] font-medium tracking-[-0.5px] text-on-surface">
            <p>{{ current_page.quote }}</p>
        </blockquote>
    </figure>
</section>
{% endif %}
