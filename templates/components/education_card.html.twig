{# One education entry (pages/education.html.twig) — see docs/style-guide.md § Education #}
<article class="rounded-[14px] border border-border bg-panel p-6 transition duration-300 ease-out hover:shadow-[0_16px_32px_-16px_rgb(23_44_73/35%)] motion-safe:hover:-translate-y-1 dark:hover:shadow-[0_16px_32px_-16px_rgb(0_0_0/60%)]">
    <div class="mb-4 flex items-start justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <p class="text-[26px] leading-none font-bold tracking-[-0.5px] text-timeline-year">{{ education.year }}</p>
            {% if education.mention is not empty %}
            <span class="rounded-md bg-highlight px-2.5 py-0.5 font-mono text-[12px] font-medium text-on-highlight">Mention {{ education.mention }}</span>
            {% endif %}
        </div>
        <img class="logo-backdrop size-12 shrink-0 rounded-[10px] border border-border object-contain p-1.5" src="{{ asset('images/education/' ~ education.school.logo) }}" alt="{{ education.school.name }}" width="48" height="48" loading="lazy">
    </div>

    <h3 class="mb-1 text-xl leading-snug font-bold">{{ education.title }}</h3>
    <p class="font-mono text-[13px] text-on-surface-muted">
        {{ education.school.name }} · {{ education.school.city }} ({{ education.school.department|format_number({ min_integer_digit: 2 }) }})
    </p>

    {% if education.details is not empty or education.speciality is not empty %}
    <ul class="mt-4 flex flex-col gap-1.5 border-t border-border pt-4 text-[15px]">
        {% if education.details is not empty %}
        <li class="flex items-baseline gap-2.5">
            <span class="size-2 shrink-0 translate-y-[-1px] rounded-full bg-primary" aria-hidden="true"></span>
            <span class="font-medium">{{ education.details }}</span>
        </li>
        {% endif %}
        {% if education.speciality is not empty %}
        <li class="flex items-baseline gap-2.5 text-on-surface-muted">
            <span class="size-2 shrink-0 translate-y-[-1px] rounded-full bg-level-end" aria-hidden="true"></span>
            <span>Option {{ education.speciality }}</span>
        </li>
        {% endif %}
    </ul>
    {% endif %}
</article>
