{# Site footer — see docs/style-guide.md § Footer #}
{% set footer_columns = [
    { title: 'Parcours', category: 'career', pages: page_manager.getPublishedRootPages() },
    { title: 'Centres d’intérêt', category: 'interest', pages: page_manager.getPublishedRootPages() },
    { title: 'À propos', category: 'about', pages: page_manager.getPublishedPages() },
] %}
<footer class="bg-surface-footer pt-24 pb-10 font-sans text-base leading-relaxed text-on-surface-footer">
    <div class="mx-auto max-w-[1240px] px-6">
        <div class="flex flex-wrap gap-x-16 gap-y-14">
            <div class="max-w-[520px] min-w-0 flex-[1_1_420px]">
                <div class="flex flex-col gap-3 [&_strong]:font-medium [&_strong]:text-white">
                    <p><strong>Product Owner depuis 2019</strong>, j’allie une <strong>solide expertise technique</strong> de 12 ans (PHP/Symfony) à une maîtrise éprouvée du delivery.</p>
                    <p>Forte d’une double <strong>sensibilité UX/UI</strong>, je pilote des équipes transverses et R&amp;D sur des produits SaaS (B2B/B2C).</p>
                    <p>Mon approche axée sur <strong>la qualité</strong> et <strong>l’automatisation</strong> me permet de résoudre des problématiques complexes, de l’infrastructure à l’expérience utilisateur.</p>
                </div>

                <ul class="mt-7 flex flex-wrap gap-2" aria-label="Réseaux et liens">
                    {% for resource in page_manager.getPublishedResourceLinks() %}
                    <li>
                        <a
                            class="inline-flex size-11 items-center justify-center rounded-[10px] border border-band-border text-white transition-colors hover:border-band-accent hover:text-band-accent"
                            href="{{ resource.url }}"
                            target="_blank"
                            rel="noopener"
                            aria-label="{{ resource.title }}">
                            {{ ux_icon(resource.icon, { class: 'size-5', 'aria-hidden': 'true' }) }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            <nav class="grid min-w-0 flex-[1_1_520px] grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-8" aria-label="Plan du site">
                {% for column in footer_columns %}
                <div>
                    <p class="mb-4 font-mono text-[13px] text-band-accent">{{ column.title }}</p>
                    <ul class="flex flex-col">
                        {% for page in column.pages %}
                        {% if page.category.value == column.category %}
                        <li>
                            <a class="flex min-h-10 items-center text-white transition-colors hover:text-band-accent" href="/{{ page.slug }}">{{ page.title }}</a>
                        </li>
                        {% endif %}
                        {% endfor %}
                    </ul>
                </div>
                {% endfor %}
            </nav>
        </div>

        <div class="mt-18 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-band-border pt-6 font-mono text-[13px]">
            <p>
                © Nine · {{ page_manager.getStartCareerYear() }}–{{ 'now'|date('Y') }}
                <span class="ml-2 rounded-md bg-tag px-2 py-0.5 text-white" title="Version du site">{{ site_version }}</span>
            </p>
            <a class="inline-flex min-h-11 items-center text-band-accent hover:underline" href="#">Retour en haut ↑</a>
        </div>
    </div>
</footer>
