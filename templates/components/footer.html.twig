{# Site footer — see docs/STYLE-GUIDE.md § Footer #}
{% set footer_columns = [
    { title: 'Parcours', category: 'career', pages: page_manager.getPublishedRootPages() },
    { title: 'Centres d’intérêt', category: 'interest', pages: page_manager.getPublishedRootPages() },
    { title: 'À propos', category: 'about', pages: page_manager.getPublishedPages() },
] %}
<footer class="bg-surface-footer pt-24 pb-10 font-sans text-[15px] leading-relaxed text-on-surface-footer">
    <div class="mx-auto max-w-[1240px] px-6">
        {# Desktop: text and links, symbol, sitemap side by side. Mobile: centred stack, links moved under the sitemap #}
        <div class="flex flex-col items-center gap-12 text-center lg:flex-row lg:items-start lg:gap-16 lg:text-left">
            <div class="max-w-[520px] min-w-0 lg:max-w-[440px] lg:flex-[1_1_360px]">
                <p class="leading-relaxed">
                    <span class="font-medium text-white">Développeur devenu Product Owner</span>, j’aime les produits clairs, les équipes soudées et le travail bien fait.
                    Basée en Auvergne, je travaille à distance.
                </p>

                <ul class="mt-7 hidden flex-wrap gap-1 lg:flex" aria-label="Réseaux et liens">
                    {% for resource in page_manager.getPublishedResourceLinks() %}
                    <li>
                        <a
                            class="inline-flex size-11 items-center justify-center rounded-[10px] text-white transition-colors hover:text-band-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-band-accent"
                            href="{{ resource.url }}"
                            target="_blank"
                            rel="noopener"
                            aria-label="{{ resource.title }}">
                            {{ ux_icon(resource.icon, { class: 'size-5', 'aria-hidden': 'true' }) }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>

            {# The image alt names the link (an aria-label with an empty alt fails WCAG H30.2 in Pa11y) #}
            <a class="shrink-0" href="{{ path('app_home') }}">
                <img class="size-16" src="{{ asset('images/global/symbol.svg') }}" alt="{{ owner_name }} — Accueil" width="64" height="64">
            </a>

            <nav class="flex w-full flex-col gap-10 lg:grid lg:w-auto lg:min-w-0 lg:flex-[1_1_480px] lg:grid-cols-[repeat(auto-fit,minmax(150px,1fr))] lg:gap-8" aria-label="Plan du site">
                {% for column in footer_columns %}
                <div>
                    <p class="mb-4 font-mono text-[13px] text-band-accent">{{ column.title }}</p>
                    <ul class="flex flex-col items-center lg:items-stretch">
                        {% for page in column.pages %}
                        {% if page.category.value == column.category %}
                        <li>
                            <a class="flex min-h-10 items-center text-white transition-colors hover:text-band-accent" href="{{ page.technicalName == 'home' ? path('app_home') : '/' ~ page.slug }}">{{ page.title }}</a>
                        </li>
                        {% endif %}
                        {% endfor %}
                    </ul>
                </div>
                {% endfor %}
            </nav>

            <ul class="flex flex-wrap justify-center gap-1 lg:hidden" aria-label="Réseaux et liens">
                {% for resource in page_manager.getPublishedResourceLinks() %}
                <li>
                    <a
                        class="inline-flex size-11 items-center justify-center rounded-[10px] text-white transition-colors hover:text-band-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-band-accent"
                        href="{{ resource.url }}"
                        target="_blank"
                        rel="noopener"
                        aria-label="{{ resource.title }}">
                        {{ ux_icon(resource.icon, { class: 'size-5', 'aria-hidden': 'true' }) }}
                    </a>
                </li>
                {% endfor %}
            </ul>
        </div>

        <div class="mt-18 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 border-t text-center lg:justify-between lg:text-left border-band-border pt-6 font-mono text-[13px]">
            <p>
                © Nine · {{ page_manager.getStartCareerYear() }}–{{ 'now'|date('Y') }}
                <span class="ml-2 rounded-md bg-tag px-2 py-0.5 text-white" title="Version du site">{{ site_version }}</span>
            </p>
            <div class="flex flex-wrap items-center justify-center gap-x-6">
                <button type="button" class="inline-flex min-h-11 cursor-pointer items-center gap-2 text-band-accent hover:underline" data-consent-open>
                    {{ ux_icon('hugeicons:cookie', { class: 'size-[18px]', 'aria-hidden': 'true' }) }}
                    Gérer les cookies
                </button>
                <a class="inline-flex min-h-11 items-center gap-2 text-band-accent hover:underline" href="#">
                    {{ ux_icon('hugeicons:arrow-up-02', { class: 'size-[18px]', 'aria-hidden': 'true' }) }}
                    Retour en haut
                </a>
            </div>
        </div>
    </div>
</footer>
