{% set is_dark = app.request.cookies.get('theme', 'light') == 'dark' %}
{# On the home page the header floats over the photo hero and turns opaque once the page scrolls (header_controller.js). #}
{% set is_overlay = current_page.slug == 'home' %}
<header
    class="site-header {{ is_overlay ? 'site-header--overlay fixed inset-x-0' : 'sticky' }} top-0 z-40 border-b border-[#24405f] bg-surface-header font-sans text-white backdrop-blur transition-colors duration-200"
    {% if is_overlay %}{{ stimulus_controller('menu')|stimulus_controller('header') }}{% else %}{{ stimulus_controller('menu') }}{% endif %}>
    <div class="site-header__bar mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-6 py-3.5">
        <a class="inline-flex min-h-11 items-center" href="{{ path('app_home') }}" aria-label="{{ owner_name }} — Accueil">
            {{ include('components/logo.html.twig') }}
        </a>

        <div class="flex items-center gap-2">
            <nav class="site-nav hidden lg:block" aria-label="Navigation principale">
                <ul class="flex items-center gap-0.5 text-sm font-medium">
                    {% for page in page_manager.getPublishedRootPagesInHeader() %}
                    {% set is_current = current_page.slug == page.slug %}
                    <li>
                        {% if page.slug == 'contact' %}
                        <a class="ml-1 inline-flex min-h-11 items-center rounded-lg bg-strong px-4 text-on-strong transition-colors hover:opacity-90" href="/{{ page.slug }}" {% if is_current %}aria-current="page"{% endif %}>{{ page.title }}</a>
                        {% else %}
                        <a class="site-nav__link inline-flex min-h-11 items-center rounded-lg px-3 text-on-surface transition-colors hover:bg-panel" href="/{{ page.slug }}" {% if is_current %}aria-current="page"{% endif %}>{{ page.title }}</a>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </nav>

            {{ include('components/theme_toggle.html.twig', { is_dark: is_dark }) }}

            <button
                type="button"
                class="site-header__menu-button inline-flex size-11 items-center justify-center rounded-[10px] border-[1.5px] border-white text-white lg:hidden"
                aria-label="Ouvrir le menu"
                aria-haspopup="dialog"
                {{ stimulus_target('menu', 'button') }}
                {{ stimulus_action('menu', 'open') }}>
                {{ ux_icon('hugeicons:menu-02', { class: 'size-5', 'aria-hidden': 'true' }) }}
            </button>
        </div>
    </div>

    {{ include('components/menu_mobile.html.twig', { is_dark: is_dark }) }}
</header>
