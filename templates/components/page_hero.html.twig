{# Inner page hero — see docs/style-guide.md § Page hero #}
<section class="page-hero relative overflow-hidden bg-[#172c49] font-sans text-white">
    <img class="absolute inset-0 size-full object-cover object-[center_40%]" src="{{ asset('images/pages/hero-' ~ current_page.technicalName ~ '.webp') }}" alt="" fetchpriority="high">
    <div class="page-hero__overlay absolute inset-0" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-[1240px] px-6 pt-8 pb-16">
        {# Breadcrumb styled as a shell path: ~/experience/coffreo/refonte-app-mobile #}
        <nav class="page-hero__breadcrumb mb-14 inline-flex max-w-full items-center gap-2.5 rounded-[10px] border px-3.5 py-2 font-mono text-[13px] sm:text-sm" aria-label="Fil d’Ariane">
            <span class="page-hero__prompt shrink-0" aria-hidden="true">❯</span>
            <ol class="flex min-w-0 items-center">
                <li class="shrink-0"><a href="{{ path('app_home') }}" aria-label="Accueil">~</a></li>
                {% set levels = ['level1', 'level2']|filter(level => breadcrumb[level] is defined) %}
                {% for level in levels %}
                <li class="page-hero__sep shrink-0 {{ not loop.last ? 'hidden sm:block' }}" aria-hidden="true">/</li>
                {% if loop.first and levels|length > 1 %}
                <li class="page-hero__sep shrink-0 sm:hidden" aria-hidden="true">/…</li>
                {% endif %}
                <li class="shrink-0 {{ not loop.last ? 'hidden sm:block' }}">
                    {# Shown as a slug, announced with its real label #}
                    <a href="{{ breadcrumb[level].url }}" aria-label="{{ breadcrumb[level].label }}" title="{{ breadcrumb[level].label }}">{{ loop.first ? breadcrumb[level].url|split('#')|first|trim('/') : breadcrumb[level].label|lower|replace({ ' ': '-' }) }}</a>
                </li>
                {% endfor %}
                <li class="page-hero__sep shrink-0" aria-hidden="true">/</li>
                <li class="min-w-0 truncate"><span class="text-white" aria-current="page" title="{{ current_page.title }}"><span aria-hidden="true">{{ current_page.slug }}</span><span class="sr-only">{{ current_page.title }}</span></span></li>
            </ol>
            <span class="page-hero__cursor shrink-0" aria-hidden="true"></span>
        </nav>

        <p class="page-hero__tagline mb-3 font-mono text-[13px] tracking-wide uppercase">{{ current_page.tagline }}</p>
        <h1 class="max-w-[760px] text-[clamp(34px,4.6vw,52px)] leading-[1.08] font-bold tracking-[-1px]">{{ current_page.subtitle }}</h1>
    </div>
</section>
