<div class="hidden nine-menu relative z-1000">
    <div class="nine-menu__backdrop fixed inset-0 bg-nine-blue-900 opacity-25"></div>
    <nav class="fixed top-0 left-0 bottom-0 flex flex-col w-5/6 max-w-sm py-6 px-6 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 overflow-y-auto transition duration-300">
        <div class="flex items-center mb-8">
            <a class="mr-auto text-3xl font-semibold leading-none" href="{{ path('app_home') }}" aria-label="{{ owner_name }} — {{ owner_role }}">
                <img class="h-10" src="https://medias.carolinenoyer.fr/images/logo-cnoyer-full-250.svg" alt="">
            </a>
            <button class="nine-menu__close" aria-label="Fermer le menu">
                {{ ux_icon('flowbite:close-outline', { class: 'h-6 w-6 text-blue-gray-400 cursor-pointer hover:text-nine-cyan-500' }) }}
            </button>
        </div>
        <div>
            <ul class="nine-menu__list">
            {% for page in page_manager.getPublishedPages() %}
                <li class="mb-1"><a class="block p-4 text-blueGray-500" href="/{{ page.slug }}" aria-label="{{ page.title }} — {{ page.subtitle }}">{{ page.title }}</a></li>
            {% endfor %}
            </ul>
        </div>
        <div class="mt-auto">
            {% for resource in page_manager.getPublishedResourceLinks() %}
            <a class="inline-block px-1" href="{{ resource.url }}" target="_blank" title="{{ resource.title }}" aria-label="{{ resource.title }}">{{ ux_icon(resource.icon, { class: 'text-2xl text-nine-cyan-500' }) }}</a>
            {% endfor %}
        </div>
    </nav>
</div>
