{# Content of an experience card (components/experience_item.html.twig) #}
{% set is_current = experience.endDate is null %}
{% set duration = experience.duration %}
{% set nb_displayed_skills = 6 %}
{% set detail_links = experience.links|filter(link => link.type.value == 'detail') %}
{% set external_links = experience.links|filter(link => link.type.value in ['external', 'pdf']) %}

<div class="mb-5 flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="min-w-0">
        <p class="mb-1 flex flex-wrap items-center gap-2 font-mono text-[13px]">
            {% if is_current %}<span class="rounded-md bg-highlight px-2.5 py-0.5 font-medium text-on-highlight">actuel</span>{% endif %}
            <span class="text-accent-text">{{ experience.title }}</span>
        </p>
        <h2 class="mb-1.5 text-[26px] leading-[1.2] font-bold">{{ experience.subtitle }}</h2>
        <p class="font-mono text-[13px] text-on-surface-muted">
            {% if is_current %}Depuis {{ experience.startDate|date('m/Y') }}{% else %}{{ experience.startDate|date('m/Y') }} → {{ experience.endDate|date('m/Y') }}{% endif %}
            ·
            {%- if duration.nbYears > 0 %} {{ duration.nbYears }} an{{ duration.nbYears > 1 ? 's' }}{% endif %}
            {%- if duration.nbMonths != 0 %}{{ duration.nbYears > 0 ? ' et' }} {{ duration.nbMonths }} mois{% endif %}
            · {{ experience.company.name }}, {{ experience.company.city }} ({{ experience.company.department|format_number({ min_integer_digit: 2 }) }})
        </p>
    </div>

    {% if external_links is not empty %}
    <ul class="flex flex-wrap gap-2">
        {% for link in external_links %}
        <li>
            <a
                class="inline-flex min-h-10 items-center gap-2 rounded-[10px] border border-border px-3.5 text-sm font-medium text-on-surface transition-colors hover:border-accent-text hover:text-accent-text"
                href="{{ link.type.value == 'pdf' ? 'https://docs.carolinenoyer.fr/' ~ link.url : link.url }}"
                target="_blank"
                rel="noopener noreferrer">
                {{ ux_icon(link.type.value == 'pdf' ? 'hugeicons:pdf-02' : 'hugeicons:globe-02', { class: 'size-4', 'aria-hidden': 'true' }) }}
                {{ link.title }}
                {{ ux_icon('hugeicons:arrow-up-right-01', { class: 'size-4 opacity-60', 'aria-hidden': 'true' }) }}
            </a>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</div>

{% if experience.items is not empty %}
<ul class="mb-6 grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] gap-x-8 gap-y-4">
    {% for item in experience.items %}
    <li>
        <h3 class="mb-0.5 font-bold">{{ item.title }}</h3>
        <p class="text-on-surface-muted">{{ item.details }}</p>
    </li>
    {% endfor %}
</ul>
{% elseif experience.description %}
<div class="mb-6 text-on-surface-muted">{{ experience.description|raw }}</div>
{% endif %}

{% if experience.skills is not empty or detail_links is not empty %}
<div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 border-t border-border pt-4">
    {% if experience.skills is not empty %}
    <div class="experience-skills flex flex-wrap items-center gap-2">
        <span class="mr-1 font-mono text-[13px] text-on-surface-muted">stack</span>
        <input type="checkbox" id="skills-toggle-{{ experience.id }}" class="peer sr-only">
        {% for skill in experience.skills %}
        <img
            class="size-8 rounded-lg bg-surface object-contain p-1 {{ loop.index > nb_displayed_skills ? 'experience-skills__extra hidden peer-checked:inline-block' }}"
            src="{{ asset('images/skills/' ~ skill.logo) }}"
            alt="{{ skill.name }}"
            title="{{ skill.name }}"
            width="32"
            height="32"
            loading="lazy">
        {% endfor %}
        {% if experience.skills|length > nb_displayed_skills %}
        <label for="skills-toggle-{{ experience.id }}" class="inline-flex min-h-8 cursor-pointer items-center rounded-md bg-chip px-2 font-mono text-xs text-on-chip peer-checked:hidden">
            +{{ experience.skills|length - nb_displayed_skills }}<span class="sr-only"> technologies, afficher tout</span>
        </label>
        {% endif %}
    </div>
    {% endif %}

    {% if detail_links is not empty %}
    <ul class="flex flex-wrap gap-2">
        {% for link in detail_links %}
        <li>
            <a class="inline-flex min-h-9 items-center gap-1.5 rounded-lg bg-chip px-3 text-sm font-medium text-on-chip transition-colors hover:underline" href="{{ path('app_experience_slug', { job: experience.slug, slug: link.page.slug }) }}">
                {{ link.title|default('Voir le détail') }} →
            </a>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
</div>
{% endif %}
