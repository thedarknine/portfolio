{% extends 'layout_login.html.twig' %}

{% block title %}Validation 2FA - Dashboard{% endblock %}

{% block body %}
<div class="bg-slate-900/60 backdrop-blur-md py-10 px-6 shadow-2xl rounded-2xl sm:px-12 border border-slate-800/80">

    {# Header #}
    <div class="mb-8 text-center">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-cyan-950 text-cyan-400 mb-3 border border-cyan-800/30">
            {{ ux_icon('hugeicons:security-password', { class: 'w-6 h-6' }) }}
        </div>
        <h2 class="text-2xl font-bold tracking-tight text-white">Double Authentification</h2>
        <p class="mt-1.5 text-sm text-slate-400">Saisissez le code généré par votre application</p>
        <p class="mt-1.5 text-sm text-slate-400">
            Connecté en tant que
            <span class="font-medium text-slate-300">
                {{ app.user.email }}
            </span>
        </p>
    </div>

{% if authenticationError is defined and authenticationError %}
    <div class="rounded-lg bg-red-950/50 p-4 text-sm text-red-400 border border-red-900/50 shadow-xs mb-5">
        {% if authenticationError is iterable %}
            {{ authenticationError.messageKey|trans(authenticationError.messageData, 'SchebTwoFactorBundle') }}
        {% else %}
            {{ authenticationError|trans({ }, 'SchebTwoFactorBundle') }}
        {% endif %}
    </div>
{% endif %}

    <form action="{{ path('2fa_login_check') }}" method="post" class="space-y-5">
        <div>
            <label for="_auth_code" class="block text-sm font-medium text-slate-300">Code de vérification</label>
            <div class="mt-1.5">
                <input
                    type="text"
                    name="{{ authCodeParameterName }}"
                    id="_auth_code"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    autocomplete="one-time-code"
                    autocorrect="off"
                    spellcheck="false"
                    autofocus
                    required
                    placeholder="000 000"
                    class="block w-full rounded-xl border border-slate-700 bg-slate-950/60 px-3.5 py-2.5 text-center text-2xl font-mono tracking-widest text-white placeholder-slate-600 focus:border-cyan-500 focus:bg-slate-950 focus:outline-hidden focus:ring-1 focus:ring-cyan-500 sm:text-lg transition-all"
                >
            </div>
        </div>

        <div class="pt-2">
            <button type="submit" class="flex w-full justify-center rounded-xl bg-cyan-600 px-4 py-3 text-sm font-semibold text-white shadow-md hover:bg-cyan-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cyan-500 cursor-pointer transition-colors">
                Vérifier le code
            </button>
        </div>

        <div class="mt-4 text-center">
            <a href="{{ path('app_logout') }}" class="text-xs font-medium text-slate-500 hover:text-slate-400 transition-colors">
                Se déconnecter et annuler
            </a>
        </div>
    </form>
</div>
{% endblock %}
