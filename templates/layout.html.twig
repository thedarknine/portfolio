<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>Caroline Noyer — {% block title %}Senior Backend Developer{% endblock %}</title>

        <link rel="shortcut icon" type="image/x-icon" href="{{ absolute_url('images/global/favicon.ico') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ absolute_url('images/global/apple-touch-icon.png') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ absolute_url('images/global/favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ absolute_url('images/global/favicon-16x16.png') }}">

        <meta name="title" content="Caroline Noyer — Technical Product Owner">
        <meta name="description" content="Product owner depuis 6 ans sur des produits SaaS B2B, compétences UX et 15 ans de background technique dans le développement web. Dynamique, autonome et minutieuse.">
        <meta name="keywords" content="CV,Design,Technical Product Owner,Product Owner,Développeur,Senior Backend Developer,PHP,Symfony">
        <meta name="author" content="Caroline Noyer">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="index,follow">
        <meta name="googlebot" content="index,follow">

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://carolinenoyer.fr/">
        <meta property="og:title" content="Caroline Noyer — Technical Product Owner">
        <meta property="og:description" content="Product owner depuis 6 ans sur des produits SaaS B2B, compétences UX et 15 ans de background technique dans le développement web. Dynamique, autonome et minutieuse.">
        <meta property="og:image" content="https://carolinenoyer.fr/images/cnoyer-product-owner.jpg">
        <meta property="og:site_name" content="Caroline Noyer Online Portfolio">

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image">
        <meta property="twitter:url" content="https://carolinenoyer.fr/">
        <meta property="twitter:title" content="Caroline Noyer — Technical Product Owner">
        <meta property="twitter:description" content="Product owner depuis 6 ans sur des produits SaaS B2B, compétences UX et 15 ans de background technique dans le développement web. Dynamique, autonome et minutieuse.">
        <meta property="twitter:image" content="https://carolinenoyer.fr/images/cnoyer-product-owner.jpg">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

        {% block stylesheets %}
        <script src="https://kit.fontawesome.com/e13f84fe9c.js" crossorigin="anonymous"></script>
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}

        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}

    </head>
    <body>
        <div class="main" id="{{ page }}">
            <!--Header-->
            <header class="bg-transparent nine-sticky-bar{% if page != 'home' %} nine-stick{% endif %}">
                <div class="container bg-transparent">
                    <nav class="bg-transparent flex justify-between items-center py-3">
                        <a class="text-3xl font-semibold leading-none" href="/">
                            <img id="logo" class="h-10" src="https://medias.carolinenoyer.fr/images/logo-cnoyer-full-250-white.svg" alt="">
                        </a>
                        <ul class="hidden lg:flex lg:items-center lg:w-auto lg:space-x-5">
                            <li class="p-4 nine-menu-item {% if page == 'experience' %}nine-active text-nine-turquoise{% endif %}">
                                <a class="" href="/experience">Expérience</a>
                            </li>
                            <li class="p-4 nine-menu-item {% if page == 'competences' %}nine-active text-nine-turquoise{% endif %}">
                                <a class="" href="/competences">Compétences</a>
                            </li>
                            <li class="p-4 nine-menu-item {% if page == 'formation' %}nine-active text-nine-turquoise{% endif %}">
                                <a class="" href="/formation">Formation</a>
                            </li>
                            <li class="p-4 nine-menu-item {% if page == 'projets' %}nine-active text-nine-turquoise{% endif %}">
                                <a class="" href="/projets">Projets</a>
                            </li>
                            <li class="p-4 nine-menu-item {% if page == 'arcade' %}nine-active text-nine-turquoise{% endif %}">
                                <a class="" href="/arcade">Arcade</a>
                            </li>
                        </ul>
                        <div class="lg:hidden">
                            <button class="nine-navbar-burger flex items-center py-2 px-3 text-nine-turquoise hover:text-nine-blue">
                                <svg class="fill-current h-6 w-6" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke="currentColor">
                                    <title>Mobile menu</title>
                                    <!--path d="M0 3h20v2H0V3zm0 6h10v2H0V9zm0 6h15v2H0v-2z"></path-->
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M 2 20 l 16 0 M 2 4 l 20 0 M 2 12 l 12 0"></path>
                                </svg>
                            </button>
                        </div>
                        {# <button id="themeToggle" class="text-lg">
                            <span id="themeIcon">☀️</span>
                        </button>


