                                        <path d="M20.3561 11.5075L20.5 10.5L20.6439 11.5075C20.7068 11.9475 21.0525 12.2932 21.4925 12.3561L22.5 12.5L21.4925 12.6439C21.0525 12.7068 20.7068 13.0525 20.6439 13.4925L20.5 14.5L20.3561 13.4925C20.2932 13.0525 19.9475 12.7068 19.5075 12.6439L18.5 12.5L19.5075 12.3561C19.9475 12.2932 20.2932 11.9475 20.3561 11.5075Z" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                            </div>
                        </div> #}
                    </nav>
                </div>
            </header>

            <!--Mobile menu-->
            <div class="hidden nine-navbar-menu relative z-1000">
                <div class="nine-navbar-backdrop fixed inset-0 bg-nine-blue-dark opacity-25"></div>
                <nav class="fixed top-0 left-0 bottom-0 flex flex-col w-5/6 max-w-sm py-6 px-6 bg-white border-r overflow-y-auto transition duration-300">
                    <div class="flex items-center mb-8">
                        <a class="mr-auto text-3xl font-semibold leading-none" href="https://carolinenoyer.fr/">
                            <img class="h-10" src="https://medias.carolinenoyer.fr/images/logo-cnoyer-full-250.svg" alt="">
                        </a>
                        <button class="nine-navbar-close">
                            <svg class="h-6 w-6 text-blue-gray-400 cursor-pointer hover:text-nine-turquoise" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div>
                        <ul class="mobile-menu">
                            <li class="mb-1">
                                <a class="block p-4 text-blueGray-500" href="/experience">Expérience</a>
                            </li>
                            <li class="mb-1">
                                <a class="block p-4 text-blueGray-500" href="/competences">Compétences</a>
                            </li>
                            <li class="mb-1">
                                <a class="block p-4 text-blueGray-500" href="/formation">Formation</a>
                            </li>
                            <li class="mb-1">
                                <a class="block p-4 text-blueGray-500" href="/projets">Projets</a>
                            </li>
                            <li class="mb-1">
                                <a class="block p-4 text-blueGray-500" href="/arcade">Arcade</a>
                            </li>
                            <li class="mb-1">
                                <a class="block p-4 text-blueGray-500" href="/creations">Créations</a>
                            </li>
                            <li class="mb-1">
                                <a class="block p-4 text-blueGray-500" href="/photos">Photos</a>
                            </li>
                        </ul>
                    </div>
                    <div class="mt-auto">
                        <a class="inline-block px-1" href="https://www.linkedin.com/in/carolinenoyer" title="LinkedIn"><i class="text-2xl text-nine-turquoise fa fa-linkedin"></i></a>
                        <a class="inline-block px-1" href="https://instagram.com/caro.noyer/" title="Instagram"><i class="text-2xl text-nine-turquoise fa-brands fa-instagram"></i></a>
                        <a class="inline-block px-2" href="https://docs.carolinenoyer.fr/pdf/cv-cnoyer-seniorbackdev.pdf" title="CV format PDF"><i class="text-2xl text-nine-turquoise fa fa-file-pdf"></i></a>
                    </div>
                </nav>
            </div>

            <main>
                {% if page != 'home' %}
                    {{ include('blocks/page_hero.html.twig', { tagline: tagline, subtitle: subtitle, slug: page }) }}
                {% endif %}

                {% block body %}{% endblock %}

                {% if page != 'home' %}
                    {{ include('blocks/page_quote.html.twig', { quote: quote }) }}
                {% endif %}
            </main>
        </div>

        <!-- Footer start -->
            <footer class="py-20">
                <section class="py-20">
                    <div class="container px-4 mx-auto">
                        <div class="flex flex-wrap mb-12 lg:mb-20 -mx-3 text-center lg:text-left">
                            <div class="w-full lg:w-2/5 px-3 mb-8 lg:mb-0 wow animate__animated animate__fadeInUp" data-wow-delay=".6s">
                                <p class="max-w-md mx-auto lg:max-w-full lg:mx-0 lg:pr-32 text-blue-gray-400 text-sm leading-relaxed">
                                <strong>Product Owner depuis 2019</strong>, forgée par <strong>15 ans de développement</strong>, je construis le pont entre la vision produit et la réalité technique.</strong><br><br>
                                De <strong>solides bases techniques</strong> et un intérêt particulier pour l’<strong>expérience utilisateur</strong>, me permettent de résoudre les
                                problèmes à tous les niveaux avec une attention portée aux détails.
                                </p>
                            </div>
                            <div class="w-full lg:w-1/5 px-3 mb-6 lg:mb-0 wow animate__animated animate__fadeInUp" data-wow-delay=".3s">
                                <a class="inline-block mx-auto lg:mx-0 text-3xl font-semibold leading-none" href="https://carolinenoyer.fr/">
                                    <img class="h-14 mx-auto" src="https://medias.carolinenoyer.fr/images/logo-2024-colored.png" alt="">
                                </a>
                            </div>
                            <div class="w-full lg:w-1/5 px-3 mb-8 lg:mb-0 wow animate__animated animate__fadeInUp" data-wow-delay=".9s">
                                <p class="mb-2 lg:mb-4 lg:text-lg text-smallcaps text-turquoise">Parcours</p>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2"><a href="/experience" class="text-blue-gray-400 text-sm">Expérience</a></li>
                                    <li class="mb-2"><a href="/competences" class="text-blue-gray-400 text-sm">Compétences</a></li>
                                    <li class="mb-2"><a href="/formation" class="text-blue-gray-400 text-sm">Formation</a></li>
                                    <li class="mb-2"><a href="/projets" class="text-blue-gray-400 text-sm">Projets</a></li>
                                </ul>
                            </div>
                            <div class="w-full lg:w-1/5 px-3 wow animate__animated animate__fadeInUp" data-wow-delay="1.2s">
                                <p class="mb-2 lg:mb-4 lg:text-lg text-smallcaps text-turquoise">Centres d'intérêt</p>
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-2"><a href="/creations" class="text-blue-gray-400 text-sm">Créations</a></li>
                                    <li class="mb-2"><a href="/photos" class="text-blue-gray-400 text-sm">Photos</a></li>
                                    <li class="mb-2"><a href="/arcade" class="text-blue-gray-400 text-sm">Arcade</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="flex flex-col lg:flex-row items-center lg:justify-between">
                            <p class="text-xs text-blue-gray-400 wow animate__animated animate__fadeInUp" data-wow-delay="1.5s"><b>©Nine | Copyright</b> 2006-{{ 'now'|date('Y') }} {# &bull; <a x-on:click="showPrivacyPolicy = true" class="" href="#"> View Privacy Policy </a> #}</p>
                            <div class="order-first lg:order-last -mx-2 mb-4 lg:mb-0 wow animate__animated animate__fadeInUp" data-wow-delay="1.8s">
                                <ul class="nine-list-inline">
                                    <li class="nine-list-inline-item"><a href="https://www.linkedin.com/in/carolinenoyer" target="_blank" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a></li>
                                    <li class="nine-list-inline-item"><a href="https://instagram.com/caro.noyer/" target="_blank" title="Instagram"><i class="fa-brands fa-instagram"></i></a></li>
                                    <li class="nine-list-inline-item"><a href="https://open.spotify.com/playlist/3g3bePO9Jddljzgx5wS4IM?si=c4a65cd590b04b94" target="_blank" title="Spotify"><i class="fa-brands fa-spotify"></i></a></li>
                                    <li class="nine-list-inline-item"><a href="https://github.com/thedarknine" target="_blank" title="GitHub"><i class="fa fa-github-alt"></i></a></li>
                                    <li class="nine-list-inline-item"><a href="https://dribbble.com/TheDarkNine" target="_blank" title="Dribbble"><i class="fab fa-dribbble"></i></a></li>
                                    <li class="nine-list-inline-item"><a href="https://docs.carolinenoyer.fr/pdf/cv-cnoyer-seniorbackdev.pdf" title="CV au format PDF"><span><i class="fa fa-file-pdf"></i></span></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </footer>
        </div>

    </body>
</html>
