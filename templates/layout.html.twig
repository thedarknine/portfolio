<!DOCTYPE html>
<html lang="fr" data-theme="{{ app.request.cookies.get('theme', 'light') }}">
    <head>
        <meta charset="UTF-8">
        <title>{% if app.environment == 'dev' %}[DEV] {% endif %}
            {% if current_page.technicalName == 'home' %}
            {{ owner_name }} — {% block meta_title %}{{ owner_role }}{% endblock %}
            {% else %}
            {{ current_page.title }} | {{ owner_name }}
            {% endif %}
        </title>

        <link rel="shortcut icon" type="image/x-icon" href="{{ absolute_url(asset('images/global/favicon.ico')) }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ absolute_url(asset('images/global/apple-touch-icon.png')) }}">
        <link rel="icon" type="image/svg+xml" href="{{ absolute_url(asset('images/global/favicon.svg')) }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ absolute_url(asset('images/global/favicon-32x32.png')) }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ absolute_url(asset('images/global/favicon-16x16.png')) }}">

        <meta name="description" content="{% block meta_description %}{{ owner_description }}{% endblock %}">
        <meta name="author" content="{{ owner_name }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="canonical" href="{{ absolute_url(app.request.uri) }}">

        {% if current_page.technicalName == 'home' %}
        <link rel="preload" as="image" href="{{ absolute_url(asset('images/volcans-cnoyer.webp')) }}" fetchpriority="high">
        {% endif %}

        {# Branded card generated per page by "task utils:og-images". The home page gets one once its unpublished
           "home" page exists in the database (HomeController), the portrait until then #}
        {% set has_og_card = current_page.technicalName is defined
            and (current_page.technicalName != 'home' or (current_page.createdAt ?? null) is not null) %}
        {% set og_image = has_og_card
            ? asset('images/og/og-' ~ current_page.technicalName ~ '.png')
            : asset('images/cnoyer-product-owner.webp') %}

        {# Open Graph / Facebook #}
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ absolute_url(app.request.uri) }}">
        <meta property="og:title" content="{{ block('meta_title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:image" content="{{ absolute_url(og_image) }}">
        {% if has_og_card %}
        <meta property="og:image:width" content="2400">
        <meta property="og:image:height" content="1260">
        {% endif %}
        <meta property="og:image:alt" content="{{ block('meta_title') }}">
        <meta property="og:site_name" content="{{ site_name }}">
        {# Publish date read by LinkedIn: only pages stored in the database have one #}
        {% set page_published = current_page.createdAt ?? null %}
        {% if page_published %}
        <meta name="publish_date" property="og:publish_date" content="{{ page_published|date('c') }}">
        <meta property="article:modified_time" content="{{ (current_page.updatedAt ?? page_published)|date('c') }}">
        {% endif %}

        {# Twitter #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('meta_title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ absolute_url(og_image) }}">

        {% block jsonld %}
        {# One Person for the whole site, with a stable @id that every page refers to #}
        {% set json_flags = constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES') %}
        {% set person_id = url('app_home') ~ '#person' %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Person",
            "@id": {{ person_id|json_encode(json_flags)|raw }},
            "name": {{ owner_name|json_encode(json_flags)|raw }},
            "jobTitle": {{ owner_role|json_encode(json_flags)|raw }},
            "description": {{ owner_description|json_encode(json_flags)|raw }},
            "url": {{ url('app_home')|json_encode(json_flags)|raw }},
            "sameAs": [
                "https://github.com/thedarknine",
                "https://www.linkedin.com/in/carolinenoyer"
            ],
            "knowsAbout": ["Symfony", "PHP", "Tailwind CSS", "UX/UI Design", "Product Ownership"]
        }
        </script>
        {% if current_page.technicalName != 'home' and current_page.slug != 'contact' %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "@id": {{ (absolute_url(app.request.uri) ~ '#webpage')|json_encode(json_flags)|raw }},
            "url": {{ absolute_url(app.request.uri)|json_encode(json_flags)|raw }},
            "name": {{ (owner_name ~ ' — ' ~ current_page.title)|json_encode(json_flags)|raw }},
            "description": {{ current_page.subtitle|json_encode(json_flags)|raw }},
            "primaryImageOfPage": {
                "@type": "ImageObject",
                "url": {{ absolute_url(asset('images/pages/hero-' ~ current_page.technicalName ~ '.webp'))|json_encode(json_flags)|raw }}
            },
            "about": { "@id": {{ person_id|json_encode(json_flags)|raw }} },
            "author": { "@id": {{ person_id|json_encode(json_flags)|raw }} },
            "creator": { "@id": {{ person_id|json_encode(json_flags)|raw }} }
        }
        </script>
        {% endif %}
        {% endblock %}

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% block importmap %}
        {{ importmap('app', { nonce: csp_nonce('script') }) }}
        {% endblock %}

    </head>
    <body>
        <div class="main" id="{{ current_page.technicalName == 'home' ? 'home' : current_page.slug }}">
            {{ include('components/header.html.twig') }}

            <main>
                {% if current_page.technicalName != 'home' and current_page.technicalName != 'legal' %}
                {{ include('components/page_hero.html.twig') }}
                {% endif %}

                {% block body %}{% endblock %}

                {% if current_page.technicalName != 'home' and current_page.technicalName != 'legal' %}
                {{ include('components/page_quote.html.twig') }}
                {% endif %}
            </main>
        </div>

        {{ include('components/footer.html.twig') }}
        {# Matomo is loaded by consent_controller.js once the visitor accepts #}
        {{ include('components/cookie_consent.html.twig') }}

    </body>
</html>
