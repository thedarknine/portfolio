                                    <input type="radio" class="absolute inset-0 appearance-none" name="theme-:r1:" aria-label="Dark theme" value="dark" checked="">
                                    <svg viewBox="0 0 28 28" fill="none">
                                        <path d="M10.5 9.99914C10.5 14.1413 13.8579 17.4991 18 17.4991C19.0332 17.4991 20.0176 17.2902 20.9132 16.9123C19.7761 19.6075 17.109 21.4991 14 21.4991C9.85786 21.4991 6.5 18.1413 6.5 13.9991C6.5 10.8902 8.39167 8.22304 11.0868 7.08594C10.7089 7.98159 10.5 8.96597 10.5 9.99914Z" stroke="currentColor" stroke-linejoin="round"></path>
                                        <path d="M16.3561 6.50754L16.5 5.5L16.6439 6.50754C16.7068 6.94752 17.0525 7.29321 17.4925 7.35607L18.5 7.5L17.4925 7.64393C17.0525 7.70679 16.7068 8.05248 16.6439 8.49246L16.5 9.5L16.3561 8.49246C16.2932 8.05248 15.9475 7.70679 15.5075 7.64393L14.5 7.5L15.5075 7.35607C15.9475 7.29321 16.2932 6.94752 16.3561 6.50754Z" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
                                        <path d="M20.3561 11.5075L20.5 10.5L20.6439 11.5075C20.7068 11.9475 21.0525 12.2932 21.4925 12.3561L22.5 12.5L21.4925 12.6439C21.0525 12.7068 20.7068 13.0525 20.6439 13.4925L20.5 14.5L20.3561 13.4925C20.2932 13.0525 19.9475 12.7068 19.5075 12.6439L18.5 12.5L19.5075 12.3561C19.9475 12.2932 20.2932 11.9475 20.3561 11.5075Z" fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
                                    </svg>
                                </div>
                            </div>
                        </div> #}
                    </nav>
                </div>
            </header>

            <!--Mobile menu-->
            <div class="hidden nine-navbar-menu relative z-1000">
                <div class="nine-navbar-backdrop fixed inset-0 bg-nine-blue-dark opacity-25"></div>
                <nav class="fixed top-0 left-0 bottom-0 flex flex-col w-5/6 max-w-sm py-6 px-6 bg-white border-r overflow-y-auto transition duration-300">
                    <div class="flex items-center mb-8">
                        <a class="mr-auto text-3xl font-semibold leading-none" href="{{ path('app_home') }}" aria-label="{{ owner_name }} — {{ owner_role }}">
                            <img class="h-10" src="https://medias.carolinenoyer.fr/images/logo-cnoyer-full-250.svg" alt="">
                        </a>
                        <button class="nine-navbar-close">
                            {{ ux_icon('flowbite:close-outline', { class: 'h-6 w-6 text-blue-gray-400 cursor-pointer hover:text-nine-turquoise' }) }}
                        </button>
                    </div>
                    <div>
                        <ul class="mobile-menu">
                        {% for page in page_manager.getPublishedPages() %}
                            <li class="mb-1"><a class="block p-4 text-blueGray-500" href="/{{ page.slug }}" aria-label="{{ page.title }} — {{ page.subtitle }}">{{ page.title }}</a></li>
                        {% endfor %}
                        </ul>
                    </div>
                    <div class="mt-auto">
                        {% for resource in page_manager.getPublishedResourceLinks() %}
                        <a class="inline-block px-1" href="{{ resource.url }}" target="_blank" title="{{ resource.title }}" aria-label="{{ resource.title }}"><i class="text-2xl text-nine-turquoise {{ resource.icon }}"></i></a>
                        {% endfor %}
                    </div>
                </nav>
            </div>

            <main>
                {% if current_page.slug != 'home' %}
                    {{ include('blocks/page_hero.html.twig') }}
                {% endif %}

                {% block body %}{% endblock %}

                {% if current_page.slug != 'home' %}
                    {{ include('blocks/page_quote.html.twig') }}
                {% endif %}
            </main>
        </div>

        <!-- Footer start -->
            <footer class="py-20">
                <section class="py-20">
                    <div class="container px-4 mx-auto">
                        <div class="flex flex-wrap mb-12 lg:mb-20 -mx-3 text-center lg:text-left">
                            <div class="w-full lg:w-2/5 px-3 mb-8 lg:mb-0 animate__animated" data-animate="animate__fadeInUp" data-delay="600">
                                <p class="max-w-md mx-auto lg:max-w-full lg:mx-0 lg:pr-32 text-blue-gray-400 text-sm leading-relaxed pb-2">
                                    <strong>Product Owner depuis 2019</strong>, j’allie une <strong>solide expertise technique</strong> de 12 ans (PHP/Symfony) à une maîtrise éprouvée du delivery.
                                </p>
                                <p class="max-w-md mx-auto lg:max-w-full lg:mx-0 lg:pr-32 text-blue-gray-400 text-sm leading-relaxed pb-2">
                                    Forte d'une double <strong>sensibilité UX/UI</strong>, je pilote des équipes transverses et R&amp;D sur des produits SaaS (B2B/B2C).
                                </p>
                                <p class="max-w-md mx-auto lg:max-w-full lg:mx-0 lg:pr-32 text-blue-gray-400 text-sm leading-relaxed">
                                    Mon approche axée sur <strong>la qualité</strong> et <strong>l'automatisation</strong> me permet de résoudre des problématiques complexes, de l'infrastructure à l'expérience utilisateur.
                                </p>
                            </div>
                            <div class="w-full lg:w-1/5 px-3 mb-6 lg:mb-0 animate__animated" data-animate="animate__fadeInUp" data-delay="300">
                                <a class="inline-block mx-auto lg:mx-0 text-3xl font-semibold leading-none" href="{{ site_url }}" aria-label="{{ owner_name }} — {{ owner_role }}">
                                    <img class="h-14 mx-auto" src="{{ asset('images/cnoyer-logo.webp') }}" alt="">
                                </a>
                            </div>
                            <div class="w-full lg:w-1/5 px-3 mb-8 lg:mb-0 animate__animated" data-animate="animate__fadeInUp" data-delay="900">
                                <p class="mb-2 lg:text-lg font-accent nine-smallcaps text-nine-turquoise">Parcours</p>
                                <ul class="list-unstyled mb-0">
                                {% for page in page_manager.getPublishedPages() %}
                                    {% if page.category.value == 'career' %}
                                    <li class="mb-2"><a href="/{{ page.slug }}" class="text-blue-gray-400 text-xs" aria-label="{{ page.title }} — {{ page.subtitle }}">{{ page.title }}</a></li>
                                    {% endif %}
                                {% endfor %}
                                </ul>
                            </div>
                            <div class="w-full lg:w-1/5 px-3 animate__animated" data-animate="animate__fadeInUp" data-delay="1200">
                                <p class="mb-2 lg:text-lg font-accent nine-smallcaps text-nine-turquoise">Centres d'intérêt</p>
                                <ul class="list-unstyled mb-0">
                                {% for page in page_manager.getPublishedPages() %}
                                    {% if page.category.value == 'interest' %}
                                    <li class="mb-2"><a href="/{{ page.slug }}" class="text-blue-gray-400 text-xs" aria-label="{{ page.title }} — {{ page.subtitle }}">{{ page.title }}</a></li>
                                    {% endif %}
                                {% endfor %}
                                </ul>
                            </div>
                        </div>
                        <div class="flex flex-col lg:flex-row items-center lg:justify-between">
                            <p class="text-xs text-blue-gray-400 animate__animated" data-animate="animate__fadeInUp" data-delay="1500"><b>©Nine | Copyright</b> {{ page_manager.getStartCareerYear() }}-{{ 'now'|date('Y') }} {# &bull; <a x-on:click="showPrivacyPolicy = true" class="" href="#"> View Privacy Policy </a> #}</p>
                            <div class="order-first lg:order-last -mx-2 mb-4 lg:mb-0 animate__animated" data-animate="animate__fadeInUp" data-delay="1800">
                                <ul class="nine-list-inline">
                                {% for resource in page_manager.getPublishedResourceLinks() %}
                                    <li class="nine-list-inline-item"><a href="{{ resource.url }}" target="_blank" title="{{ resource.title }}" aria-label="{{ resource.title }}">{{ ux_icon(resource.icon, { class: 'w-5 h-5' }) }}</a></li>
                                {% endfor %}
                            </ul>
                            </div>
                        </div>
                    </div>
                </section>
            </footer>
        </div>

    </body>
</html>
