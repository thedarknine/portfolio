<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% if app.environment == 'dev' %}[DEV] {% endif %}{{ owner_name }} — {% block title %}{{ owner_role }}{% endblock %}</title>

        <link rel="shortcut icon" type="image/x-icon" href="{{ absolute_url(asset('images/global/favicon.ico')) }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ absolute_url(asset('images/global/apple-touch-icon.png')) }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ absolute_url(asset('images/global/favicon-32x32.png')) }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ absolute_url(asset('images/global/favicon-16x16.png')) }}">

        <title>{% block meta_title %}{{ owner_name }} — {{ owner_role }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ owner_description }}{% endblock %}">
        <meta name="author" content="{{ owner_name }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="canonical" href="{{ absolute_url(app.request.uri) }}">

        {# Open Graph / Facebook #}
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ absolute_url(app.request.uri) }}">
        <meta property="og:title" content="{{ block('meta_title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/cnoyer-product-owner.webp')) }}">
        <meta property="og:site_name" content="{{ site_name }}">

        {# Twitter #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('meta_title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ absolute_url(asset('images/cnoyer-product-owner.webp')) }}">

        {% block jsonld %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Person",
            "@id": "{{ absolute_url(app.request.uri) }}#person",
            "name": "{{ owner_name }}",
            "jobTitle": "{{ owner_role }}",
            "description": "{{ owner_description }}",
            "url": "{{ absolute_url(app.request.uri) }}",
            "sameAs": [
                "https://github.com/thedarknine",
                "https://www.linkedin.com/in/carolinenoyer"
            ],
            "knowsAbout": ["Symfony", "PHP", "Tailwind CSS", "UX/UI Design", "Product Ownership"]
        }
        </script>
        {% if current_page.slug != 'home' %}
            <script type="application/ld+json">
            {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "@id": "{{ absolute_url(app.request.uri) }}#webpage",
            "url": "{{ absolute_url(app.request.uri) }}",
            "name": "{{ owner_name }} — {{ current_page.tagline }}",
            "description": "{{ current_page.subtitle }}",
            "primaryImageOfPage": {
                "@type": "ImageObject",
                "url": "{{ absolute_url(asset('images/' ~ current_page.technicalName ~ '/hero-' ~ current_page.technicalName ~ '.jpg')) }}"
            },
            "about": {
                "@id": "{{ absolute_url(app.request.uri) }}#person"
            },
            "author": {
                "@type": "Person",
                "name": "{{ owner_name }}"
            },
            "creator": {
                "@type": "Person",
                "name": "{{ owner_name }}"
            }
            }
            </script>
        {% endif %}
        {% endblock %}

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}

    </head>
    <body>
        <div class="main" id="{{ current_page.slug ?? 'home' }}">
            <!--Header-->
            <header class="bg-transparent nine-sticky-bar{% if current_page.slug != 'home' %} nine-stick{% endif %}">
                <div class="container bg-transparent">
                    <nav class="bg-transparent flex justify-between items-center py-3">
                        <a class="text-3xl font-semibold leading-none" href="{{ path('app_home') }}" aria-label="{{ owner_name }} — {{ owner_role }}">
                            <img id="logo" class="h-10" src="https://medias.carolinenoyer.fr/images/logo-cnoyer-full-250-white.svg" alt="">
                        </a>
                        <ul class="hidden lg:flex lg:items-center lg:w-auto lg:space-x-5">
                        {% for page in page_manager.getPublishedPagesInHeader() %}
                            <li class="p-4 nine-menu-item {% if current_page.slug == page.slug %}nine-active text-nine-turquoise{% endif %}">
                                <a class="" href="/{{ page.slug }}" aria-label="{{ page.title }} — {{ page.subtitle }}">{{ page.title }}</a>
                            </li>
                        {% endfor %}
                        </ul>
                        <div class="lg:hidden">
                            <button class="nine-navbar-burger flex items-center py-2 px-3 text-nine-turquoise hover:text-nine-blue">
                                {{ ux_icon('hugeicons:menu-02', { class: 'w-8 h-8' }) }}
                            </button>
                        </div>
                        {# <button id="themeToggle" class="text-lg">
                            <span id="themeIcon">☀️</span>
                        </button>


                        <div class="grid grid-cols-1 max-sm:hidden">
                            <div class="relative z-0 inline-grid grid-cols-2 gap-0.5 rounded-full bg-gray-950/5 p-0.75 text-gray-950 dark:bg-white/10 dark:text-white">
