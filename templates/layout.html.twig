<!DOCTYPE html>
<html lang="fr" data-theme="{{ app.request.cookies.get('theme', 'light') }}">
    <head>
        <meta charset="UTF-8">
        <title>{% if app.environment == 'dev' %}[DEV] {% endif %}{{ owner_name }} — {% block meta_title %}{{ owner_role }}{% endblock %}</title>

        <link rel="shortcut icon" type="image/x-icon" href="{{ absolute_url(asset('images/global/favicon.ico')) }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ absolute_url(asset('images/global/apple-touch-icon.png')) }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ absolute_url(asset('images/global/favicon-32x32.png')) }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ absolute_url(asset('images/global/favicon-16x16.png')) }}">

        <meta name="description" content="{% block meta_description %}{{ owner_description }}{% endblock %}">
        <meta name="author" content="{{ owner_name }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <link rel="canonical" href="{{ absolute_url(app.request.uri) }}">

        {# Open Graph / Facebook #}
        <meta property="og:type" content="website">
        <meta property="og:url" content="{{ absolute_url(app.request.uri) }}">
        <meta property="og:title" content="{{ block('meta_title') }}">
        <meta property="og:description" content="{{ block('meta_description') }}">
        <meta property="og:image" content="{{ absolute_url(asset('images/cnoyer-product-owner.webp')) }}">
        <meta property="og:site_name" content="{{ site_name }}">

        {# Twitter #}
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{{ block('meta_title') }}">
        <meta name="twitter:description" content="{{ block('meta_description') }}">
        <meta name="twitter:image" content="{{ absolute_url(asset('images/cnoyer-product-owner.webp')) }}">

        {% block jsonld %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "Person",
            "@id": "{{ absolute_url(app.request.uri) }}#person",
            "name": "{{ owner_name }}",
            "jobTitle": "{{ owner_role }}",
            "description": "{{ owner_description }}",
            "url": "{{ absolute_url(app.request.uri) }}",
            "sameAs": [
                "https://github.com/thedarknine",
                "https://www.linkedin.com/in/carolinenoyer"
            ],
            "knowsAbout": ["Symfony", "PHP", "Tailwind CSS", "UX/UI Design", "Product Ownership"]
        }
        </script>
        {% if current_page.slug != 'home' and current_page.slug != 'contact' %}
            <script type="application/ld+json">
            {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "@id": "{{ absolute_url(app.request.uri) }}#webpage",
            "url": "{{ absolute_url(app.request.uri) }}",
            "name": "{{ owner_name }} — {{ current_page.tagline }}",
            "description": "{{ current_page.subtitle }}",
            "primaryImageOfPage": {
                "@type": "ImageObject",
                "url": "{{ absolute_url(asset('images/pages/hero-' ~ current_page.technicalName ~ '.webp')) }}"
            },
            "about": {
                "@id": "{{ absolute_url(app.request.uri) }}#person"
            },
            "author": {
                "@type": "Person",
                "name": "{{ owner_name }}"
            },
            "creator": {
                "@type": "Person",
                "name": "{{ owner_name }}"
            }
            }
            </script>
        {% endif %}
        {% endblock %}

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}

        {# Start Matomo #}
        <script>
            var _paq = window._paq = window._paq || [];
            /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
            _paq.push(["setDoNotTrack", true]);
            _paq.push(['setIpAnonymization', true]);
            _paq.push(['trackPageView']);
            _paq.push(['enableLinkTracking']);
            (function() {
                var u="https://analytics.carolinenoyer.fr/";
                _paq.push(['setTrackerUrl', u+'matomo.php']);
                _paq.push(['setSiteId', '1']);
                var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
                g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
            })();
        </script>
        {# End Matomo Code #}
    </head>
    <body>
        <div class="main" id="{{ current_page.slug ?? 'home' }}">
            {{ include('components/header.html.twig') }}

            {{ include('components/menu_mobile.html.twig') }}

            <main>
                {% if current_page.slug != 'home' and current_page.technicalName != 'legal' %}
                    {{ include('components/page_hero.html.twig') }}
                {% endif %}

                {% block body %}{% endblock %}

                {% if current_page.slug != 'home' and current_page.technicalName != 'legal' %}
                    {{ include('components/page_quote.html.twig') }}
                {% endif %}
            </main>
        </div>

        {{ include('components/footer.html.twig') }}

    </body>
</html>
