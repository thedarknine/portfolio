{
  "defaults": {
    "standard": "WCAG2AA",
    "reporters": [
      ["pa11y-ci-reporter-html", { "destination": ".tools/reports/pa11y" }]
    ],
    "chromeLaunchConfig": {
      "executablePath": "/usr/bin/chromium",
      "args": [
        "--no-sandbox",
        "--disable-dev-shm-usage",
        "--disable-gpu",
        "--no-zygote",
        "--headless"
      ]
    }
  },
  "urls": [
    "http://engine/"
  ]
}
