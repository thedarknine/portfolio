{
    "type": "project",
    "name": "lab/portfolio",
    "description": "My personal portfolio",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.2.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6.7",
        "easycorp/easyadmin-bundle": "^5.1.0",
        "gedmo/doctrine-extensions": "^3.22",
        "nelmio/security-bundle": "^3.9",
        "nesbot/carbon": "^3.13.0",
        "presta/sitemap-bundle": "^4.3",
        "scheb/2fa-google-authenticator": "^8.5",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/asset": "8.0.*",
        "symfony/asset-mapper": "8.0.*",
        "symfony/console": "8.0.*",
        "symfony/dotenv": "8.0.*",
        "symfony/flex": "^2.11",
        "symfony/form": "8.0.*",
        "symfony/framework-bundle": "8.0.*",
        "symfony/mailer": "8.0.*",
        "symfony/monolog-bundle": "^4.0.2",
        "symfony/rate-limiter": "8.0.*",
        "symfony/runtime": "8.0.*",
        "symfony/twig-bundle": "8.0.*",
        "symfony/ux-icons": "^3.2",
        "symfony/validator": "8.0.*",
        "symfony/yaml": "8.0.*",
        "symfonycasts/tailwind-bundle": "^0.12.0",
        "tito10047/altcha-bundle": "*",
        "twig/extra-bundle": "^2.12|^3.24",
        "twig/intl-extra": "^3.26",
        "twig/twig": "^2.12|^3.27.1"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "pipeline:fixtures": [
            "php bin/console app:generate-fixtures --group=test",
            "php bin/console doctrine:database:drop --env=test --force --if-exists",
            "php bin/console doctrine:database:create --env=test",
            "php bin/console doctrine:schema:update --env=test --force",
            "php bin/console doctrine:fixtures:load --env=test --group=test --no-interaction",
            "rm -rf src/DataFixtures/Testing"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.0.*"
        },
        "grumphp": {
            "config-default-path": ".tools/grumphp.yml",
            "disable-plugin": false
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.6",
        "dbrekelmans/bdi": "^1.4.1",
        "deptrac/deptrac": "^4.6",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.11",
        "infection/infection": "^0.33.3",
        "phparkitect/phparkitect": "^1.1.1",
        "phpro/grumphp": "^2.22",
        "phpstan/phpstan": "^2.2.1",
        "phpstan/phpstan-doctrine": "^2.0.25",
        "phpunit/phpunit": "^13.1.13",
        "rector/rector": "^2.5.2",
        "symfony/browser-kit": "8.0.*",
        "symfony/css-selector": "8.0.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/panther": "^2.4",
        "vincentlanglet/twig-cs-fixer": "^3.14"
    }
}
