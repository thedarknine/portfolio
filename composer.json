{
    "type": "project",
    "name": "lab/portfolio",
    "description": "My personal portfolio",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/doctrine-bundle": "^3.4.1",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.8.0",
        "easycorp/easyadmin-bundle": "^5.10.1",
        "gedmo/doctrine-extensions": "^3.22.2",
        "nelmio/security-bundle": "^3.9",
        "nesbot/carbon": "^3.15.1",
        "presta/sitemap-bundle": "^4.3.1",
        "scheb/2fa-google-authenticator": "^8.7.0",
        "stof/doctrine-extensions-bundle": "^1.15.3",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/form": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/monolog-bundle": "^4.1.0",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/stimulus-bundle": "^3.7",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-icons": "^3.7",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "symfonycasts/tailwind-bundle": "^1.0",
        "tito10047/altcha-bundle": "^3.1",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/intl-extra": "^3.30",
        "twig/twig": "^2.12|^3.30.0"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true,
            "phpro/grumphp": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "pipeline:fixtures": [
            "php bin/console app:generate-fixtures --group=test",
            "php bin/console doctrine:database:drop --env=test --force --if-exists",
            "php bin/console doctrine:database:create --env=test",
            "php bin/console doctrine:schema:update --env=test --force",
            "php bin/console doctrine:fixtures:load --env=test --group=test --no-interaction",
            "rm -rf src/DataFixtures/Testing"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        },
        "grumphp": {
            "config-default-path": ".tools/config/grumphp.yml",
            "disable-plugin": false
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.8.0",
        "dbrekelmans/bdi": "^1.4.1",
        "deptrac/deptrac": "^4.7.2",
        "doctrine/doctrine-fixtures-bundle": "^4.3.1",
        "friendsofphp/php-cs-fixer": "^3.95.30",
        "infection/infection": "^0.35",
        "phparkitect/phparkitect": "^1.3.1",
        "phpro/grumphp": "^2.26",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-doctrine": "^2.1.2",
        "phpunit/phpunit": "^13.4.7",
        "rector/rector": "^2.8.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/panther": "^2.4",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    }
}
