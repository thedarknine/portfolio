PROJECT_NAME=Portfolio
PROJECT_SLUG=portfolio
ENVIRONMENT=dev
# Secrets (APP_SECRET, EASYADMIN_PASSWORD, ALTCHA_SECRET, REMOTE_*) go in .env.local, never committed.

###> Docker Compose files ###
# Read by "docker compose": dev services are added on top of the base file.
# In production, set COMPOSE_FILE=docker-compose.yaml in the server environment.
COMPOSE_FILE=docker-compose.yaml:docker-compose.dev.yaml
# Host ports: change them to run several projects side by side
APP_PORT=8000
DB_PORT=3306
ADM_PORT=8089
MAIL_PORT=8025
CHROME_PORT=4444
# On Linux, set your own ids in .env.local (run "id -u" and "id -g"), then rebuild the image.
# Not needed with Docker Desktop (macOS, Windows).
# HOST_UID=1000
# HOST_GID=1000
###< Docker Compose files ###

###> Versions for docker containers ###
PHP_VERSION=8.4
# Same engine and version as production (Hostinger)
MARIADB_VERSION=11.8
NGINX_VERSION=1.30
###< Versions for docker containers ###

DB_ROOT_PASS=admin
DB_NAME=portfolio
DB_USER=thedarknine
DB_PASS=plop

REMOTE_HOST=yourdomain.com
REMOTE_USER=yourusername
REMOTE_PASS=
REMOTE_SSH_KEY=~/.ssh/yourkey
REMOTE_PORT=22

# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://carolinenoyer.fr
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# "db" is the MariaDB service of docker-compose.dev.yaml (dev only). In production, set DATABASE_URL in .env.local.
DATABASE_URL="mysql://${DB_USER}:${DB_PASS}@db:3306/${DB_NAME}?serverVersion=11.8.9-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

EASYADMIN_USER=admin
EASYADMIN_PASSWORD=

###> symfony/mailer ###
#MAILER_DSN=null://null
MAILER_DSN=smtp://mailpit:1025
###< symfony/mailer ###

###> tito10047/altcha-bundle ###
ALTCHA_SECRET=
###< tito10047/altcha-bundle ###
